<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>VL.Fuse</id>
    <version>0.1.6</version>
    <authors>The Fuse Lab</authors>
    <owners>The Fuse Lab</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">LGPL-3.0-only</license>
    <licenseUrl>https://licenses.nuget.org/LGPL-3.0-only</licenseUrl>
    <projectUrl>https://github.com/TheFuseLab/VL.Fuse</projectUrl>
    <description>A collection of GPU tools and libraries to use with VL.Stride</description>
    <tags>VL, gpu</tags>
    <dependencies>
      <dependency id="VL.IO.Ply" version="0.0.8-alpha" />
      <dependency id="VL.Alembic" version="0.3.1" />
      <dependency id="VL.Nvidia.CUDA" version="0.2.2" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\*.vl" target="" exclude="" />
    <file src="..\vl\*.vl" target="\vl" exclude="" />
    <file src="..\vl\shaders\*.sdsl" target="\vl\shaders" exclude="" />
    <file src="..\help\**\*.vl" target="\help" exclude="" />
    <file src="..\lib\**\*.dll" target="lib\" exclude="" />
    <file src="..\resources\**\*.*" target="\resources" exclude="" />
  </files>
</package>