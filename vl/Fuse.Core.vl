                <Pad Id="Oh2zWZRnLBoQYSzTClMMiZ" Comment="" Bounds="207,160,490,131" ShowValueBox="true" isIOBox="true" Value="${resultType} ${signature}(${resultType} Base, ${resultType} Blend, ${resultType} Opacity)&#xD;&#xA;{&#xD;&#xA;    ${resultType} result1 = 1.0 - 2.0 * (1.0 - Base) * (1.0 - Blend);&#xD;&#xA;    ${resultType} result2 = 2.0 * Base * Blend;&#xD;&#xA;    ${resultType} zeroOrOne = step(Base, 0.5);&#xD;&#xA;    ${resultType} Out = result2 * zeroOrOne + (1 - zeroOrOne) * result1;&#xD;&#xA;    return lerp(Base, Out, Opacity);&#xD;&#xA;}">
