        <Node Name="ProjectPointOnLine" Bounds="1106,1139" Id="RgugN3jVTAQQK9ZL1oQWSp">
          <p:NodeReference>
            <Choice Kind="ContainerDefinition" />
          </p:NodeReference>
          <Patch Id="Nprk2vY2nqTOccnvbYVeHi" IsGeneric="true">
            <Canvas Id="RJ5dbzwu41eObQdcpxPo1m" CanvasType="Group">
              <Pad Id="VmYP2L0Cec8P4f4vFSJsS9" Bounds="1207,356,638,542" ShowValueBox="true" isIOBox="true" Value="float CalculateDistanceProgress(float3 particlePosition, float3 startNodePosition, float3 endNodePosition)&#xD;&#xA;{&#xD;&#xA;    float3 segmentVector = endNodePosition - startNodePosition;&#xD;&#xA;    float3 particleVector = particlePosition - startNodePosition;&#xD;&#xA;&#xD;&#xA;    float segmentLengthSq = dot(segmentVector, segmentVector);&#xD;&#xA;&#xD;&#xA;    // Handle zero-length segments (or very small segments)&#xD;&#xA;    float epsilon = 1e-6f; // A small value to avoid division by zero&#xD;&#xA;    if (segmentLengthSq &lt; epsilon)&#xD;&#xA;    {&#xD;&#xA;        // Nodes are coincident or very close. Define behavior.&#xD;&#xA;        // Option 1: Consider it fully progressed if start/end are same.&#xD;&#xA;        return 1.0f;&#xD;&#xA;        // Option 2: Consider it not started.&#xD;&#xA;        // return 0.0f;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // Calculate projection dot product&#xD;&#xA;    float projectionDot = dot(particleVector, segmentVector);&#xD;&#xA;&#xD;&#xA;    // Calculate raw progress&#xD;&#xA;    float rawProgress = projectionDot / segmentLengthSq;&#xD;&#xA;&#xD;&#xA;    // Clamp progress to the standard [0, 1] range&#xD;&#xA;    float progress = clamp(rawProgress, 0.0f, 1.0f);&#xD;&#xA;&#xD;&#xA;    return progress;&#xD;&#xA;}">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
                <p:ValueBoxSettings>
                  <p:fontsize p:Type="Int32">9</p:fontsize>
                  <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                </p:ValueBoxSettings>
              </Pad>
