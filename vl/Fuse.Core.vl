    ************************ Spline ************************

-->
        <Node Name="Spline" Bounds="1882,1389" Id="KV4dKVQTkIGNWC07OwAqpk">
          <p:NodeReference LastCategoryFullName="Primitive" LastDependency="Builtin">
            <Choice Kind="ContainerDefinition" Name="Process" />
          </p:NodeReference>
          <Patch Id="C5jIBQQ7Q8aOgIQ1l9Jm5M" IsGeneric="true" ExplicitTypeParameters="T">
            <Canvas Id="O7t52JEa32FOReesslUmWv" CanvasType="Group">
              <Pad Id="J5FDXO5FOuHN6oflExCrXU" Comment="io" Bounds="222,110,240,310" ShowValueBox="true" isIOBox="true" Value="// Cubic Spline&#xD;&#xA;${resultType} ${signature}(&#xD;&#xA;    ${resultType} start, &#xD;&#xA;    ${resultType} anchor1, &#xD;&#xA;    ${resultType} anchor2, &#xD;&#xA;    ${resultType} end, &#xD;&#xA;    float t&#xD;&#xA;) {&#xD;&#xA;    float u = 1.0 - t;&#xD;&#xA;    float tt = t * t;&#xD;&#xA;    float uu = u * u;&#xD;&#xA;    float uuu = uu * u;&#xD;&#xA;    float ttt = tt * t;&#xD;&#xA;&#xD;&#xA;    ${resultType} p = uuu * start; // first term&#xD;&#xA;    p += 3 * uu * t * anchor1; // second term&#xD;&#xA;    p += 3 * u * tt * anchor2; // third term&#xD;&#xA;    p += ttt * end; // fourth term&#xD;&#xA;&#xD;&#xA;    return p;&#xD;&#xA;}">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
              </Pad>
              <Pad Id="SeJQu7qN8tbLBy63vCeDfv" Comment="io" Bounds="577,106,304,310" ShowValueBox="true" isIOBox="true" Value="// Hermite Spline&#xD;&#xA;${resultType} ${signature}(&#xD;&#xA;    ${resultType} start,&#xD;&#xA;    ${resultType} m0, &#xD;&#xA;    ${resultType} m1,  &#xD;&#xA;    ${resultType} end, &#xD;&#xA;    float t&#xD;&#xA;) {&#xD;&#xA;    float t2 = t * t;&#xD;&#xA;    float t3 = t2 * t;&#xD;&#xA;&#xD;&#xA;    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;&#xD;&#xA;    float h10 = t3 - 2.0 * t2 + t;&#xD;&#xA;    float h01 = -2.0 * t3 + 3.0 * t2;&#xD;&#xA;    float h11 = t3 - t2;&#xD;&#xA;&#xD;&#xA;    return h00 * start + h10 * m0 + h01 * end + h11 * m1;&#xD;&#xA;}&#xD;&#xA;">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
              </Pad>
              <Pad Id="KNONHlZjlXCOeTJPtlXKv2" Comment="io" Bounds="935,105,288,261" ShowValueBox="true" isIOBox="true" Value="// Seiler Spline&#xD;&#xA;${resultType} ${signature}(&#xD;&#xA;    ${resultType} start, &#xD;&#xA;    ${resultType} anchor1, &#xD;&#xA;    ${resultType} anchor2, &#xD;&#xA;    ${resultType} end, &#xD;&#xA;    float t&#xD;&#xA;) {&#xD;&#xA;    ${resultType} s1 = 3 * anchor1 - start - end;&#xD;&#xA;    ${resultType} s2 = 3 * anchor2 - end - start;&#xD;&#xA;&#xD;&#xA;    ${resultType} b03 = lerp(start, end, t);&#xD;&#xA;    ${resultType} s12 = lerp(s1, s2, t);&#xD;&#xA;&#xD;&#xA;    ${resultType} result = lerp(b03, s12, (1 - t) * t);&#xD;&#xA;    return result;&#xD;&#xA;}&#xD;&#xA;">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
              </Pad>
              <Node Bounds="221,594,719,19" Id="QvCK6l7AZiVP9bQ31rwTxW">
