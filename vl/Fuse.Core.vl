                <Pin Id="RY1XpCGi7fQMJJjFmM4eo3" Name="Output" Kind="OutputPin" />
              </Node>
              <Pad Id="IlIPhWqTWkoP5gmXNYNal7" Bounds="442,127,498,117" ShowValueBox="true" isIOBox="true" Value="float3 safe_normalize(float3 v) {&#xD;&#xA;    float lenSq = dot(v, v); // Squared length (faster than length())&#xD;&#xA;    if (lenSq &gt; 1e-12) // Avoids division by zero while being branch-friendly&#xD;&#xA;        return v * rsqrt(lenSq); // Faster than v / sqrt(lenSq)&#xD;&#xA;    return float3(0, 0, 0); // Return zero vector if input is nearly zero&#xD;&#xA;}&#xD;&#xA;">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
                <p:ValueBoxSettings>
                  <p:fontsize p:Type="Int32">9</p:fontsize>
                  <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                </p:ValueBoxSettings>
              </Pad>
