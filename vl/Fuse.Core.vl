              <Pad Id="JcX7kClyMAcMt470BejOYn" Comment="" Bounds="679,358,286,177" ShowValueBox="true" isIOBox="true" Value="float ${signature}_grid(float2 p, float width)&#xD;&#xA;{&#xD;&#xA;&#x9;float grid = 0.;&#xD;&#xA;&#x9;float freq = 4.;&#xD;&#xA;&#x9;// main axis&#xD;&#xA;&#x9;grid = step(abs(p.x), width*.5);&#xD;&#xA;&#x9;grid = max(step(abs(p.y), width*.5), grid); &#xD;&#xA;&#x9;// grid lines&#xD;&#xA;&#x9;grid = max(step(frac(p.x * freq), width * freq)*.2, grid);&#xD;&#xA;&#x9;grid = max(step(frac(p.y * freq), width * freq)*.2, grid);&#xD;&#xA;&#x9;return grid;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;">
