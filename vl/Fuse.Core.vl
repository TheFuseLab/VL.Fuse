        <!--

    ************************ NeighborSpline ************************

-->
        <Node Name="NeighborSpline" Bounds="1885,1432" Id="FIomTWreH3cPurptYJgtwj">
          <p:NodeReference LastCategoryFullName="Primitive" LastDependency="Builtin">
            <Choice Kind="ContainerDefinition" Name="Process" />
          </p:NodeReference>
          <Patch Id="QPNTPIjohbNLIHlr3vcTcb" IsGeneric="true" ExplicitTypeParameters="T">
            <Canvas Id="EF3dZPfZkPILYLaj1SXrkI" CanvasType="Group">
              <Pad Id="GTvFOqqo0FcMlx2NN0DzyG" Comment="io" Bounds="168,132,341,308" ShowValueBox="true" isIOBox="true" Value="// Catmull-Rom Spline&#xD;&#xA;${resultType} ${signature}(&#xD;&#xA;    ${resultType} prev, &#xD;&#xA;    ${resultType} start, &#xD;&#xA;    ${resultType} end, &#xD;&#xA;    ${resultType} next, &#xD;&#xA;    float t&#xD;&#xA;) {&#xD;&#xA;    float t2 = t * t;&#xD;&#xA;    float t3 = t2 * t;&#xD;&#xA;&#xD;&#xA;    ${resultType} a = -0.5 * prev + 1.5 * start - 1.5 * end + 0.5 * next;&#xD;&#xA;    ${resultType} b = prev - 2.5 * start + 2.0 * end - 0.5 * next;&#xD;&#xA;    ${resultType} c = -0.5 * prev + 0.5 * end;&#xD;&#xA;    ${resultType} d = start;&#xD;&#xA;&#xD;&#xA;    return a * t3 + b * t2 + c * t + d;&#xD;&#xA;}">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
              </Pad>
              <Pad Id="MA7eoO2OuOBN14yOxHmape" Comment="io" Bounds="566,132,357,308" ShowValueBox="true" isIOBox="true" Value="// B-Spline&#xD;&#xA;${resultType} ${signature}(&#xD;&#xA;    ${resultType} prev, &#xD;&#xA;    ${resultType} start, &#xD;&#xA;    ${resultType} end, &#xD;&#xA;    ${resultType} next, &#xD;&#xA;    float t&#xD;&#xA;) {&#xD;&#xA;    float t2 = t * t;&#xD;&#xA;    float t3 = t2 * t;&#xD;&#xA;&#xD;&#xA;    ${resultType} result = (1.0 / 6.0) * (&#xD;&#xA;        (-t3 + 3 * t2 - 3 * t + 1) * prev +&#xD;&#xA;        (3 * t3 - 6 * t2 + 4) * start +&#xD;&#xA;        (-3 * t3 + 3 * t2 + 3 * t + 1) * end +&#xD;&#xA;        (t3) * next&#xD;&#xA;    );&#xD;&#xA;&#xD;&#xA;    return result;&#xD;&#xA;}&#xD;&#xA;">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
              </Pad>
              <Pad Id="OaCkV0YzskyNq7xZ9rcT3i" Comment="io" Bounds="973,130,437,309" ShowValueBox="true" isIOBox="true" Value="// Cardinal Spline&#xD;&#xA;${resultType} ${signature}(&#xD;&#xA;    ${resultType} prev, &#xD;&#xA;    ${resultType} start, &#xD;&#xA;    ${resultType} end, &#xD;&#xA;    ${resultType} next, &#xD;&#xA;    float t, &#xD;&#xA;    float tension = 0.0 // Default value for tension&#xD;&#xA;) {&#xD;&#xA;    float t2 = t * t;&#xD;&#xA;    float t3 = t2 * t;&#xD;&#xA;    float s = (1.0 - tension) / 2.0;&#xD;&#xA;&#xD;&#xA;    ${resultType} a = -s * prev + (2.0 - s) * start + (s - 2.0) * end + s * next;&#xD;&#xA;    ${resultType} b = 2.0 * s * prev + (s - 3.0) * start + (3.0 - 2.0 * s) * end - s * next;&#xD;&#xA;    ${resultType} c = -s * prev + s * end;&#xD;&#xA;    ${resultType} d = start;&#xD;&#xA;&#xD;&#xA;    return a * t3 + b * t2 + c * t + d;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
              </Pad>
              <Pad Id="UtbMz6PMvSbNCsRkqE142L" Comment="io" Bounds="1442,128,510,390" ShowValueBox="true" isIOBox="true" Value="// Kochanek-Bartels Spline&#xD;&#xA;${resultType} ${signature}(&#xD;&#xA;    ${resultType} prev, &#xD;&#xA;    ${resultType} start, &#xD;&#xA;    ${resultType} end, &#xD;&#xA;    ${resultType} next, &#xD;&#xA;    float t, &#xD;&#xA;    float tension = 0.0,    // Default value for tension&#xD;&#xA;    float bias = 0.0,       // Default value for bias&#xD;&#xA;    float continuity = 0.0  // Default value for continuity&#xD;&#xA;) {&#xD;&#xA;    float t2 = t * t;&#xD;&#xA;    float t3 = t2 * t;&#xD;&#xA;&#xD;&#xA;    ${resultType} d1 = ((1 - tension) * (1 + bias) * (1 + continuity) / 2.0) * (start - prev) +&#xD;&#xA;                      ((1 - tension) * (1 - bias) * (1 - continuity) / 2.0) * (end - start);&#xD;&#xA;    ${resultType} d2 = ((1 - tension) * (1 + bias) * (1 - continuity) / 2.0) * (end - start) +&#xD;&#xA;                      ((1 - tension) * (1 - bias) * (1 + continuity) / 2.0) * (next - end);&#xD;&#xA;&#xD;&#xA;    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;&#xD;&#xA;    float h10 = t3 - 2.0 * t2 + t;&#xD;&#xA;    float h01 = -2.0 * t3 + 3.0 * t2;&#xD;&#xA;    float h11 = t3 - t2;&#xD;&#xA;&#xD;&#xA;    return h00 * start + h10 * d1 + h01 * end + h11 * d2&#xD;&#xA;">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
              </Pad>
