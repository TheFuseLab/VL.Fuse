                <Pad Id="UorvNsByktQO2QFihMXJKq" Comment="" Bounds="108,185,491,131" ShowValueBox="true" isIOBox="true" Value="${resultType} ${signature}(${resultType} Base, ${resultType} Blend, ${resultType} Opacity)&#xD;&#xA;{;&#xD;&#xA;    ${resultType} result1 = 1.0 - (1.0 - Blend) / (2.0 * Base);&#xD;&#xA;    ${resultType} result2 = Blend / (2.0 * (1.0 - Base));&#xD;&#xA;    ${resultType} zeroOrOne = step(0.5, Base);&#xD;&#xA;    ${resultType} Out = result2 * zeroOrOne + (1 - zeroOrOne) * result1;&#xD;&#xA;    return lerp(Base, Out, Opacity);&#xD;&#xA;}">
