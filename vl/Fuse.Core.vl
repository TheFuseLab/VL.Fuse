        <!--

    ************************ InterlockedXor (Texture) ************************

-->
        <Node Name="InterlockedXor (Texture)" Bounds="1226,340" Id="UsqVCvTe5EQPhvD6d6mXvw" Summary="Performs a guaranteed atomic xor." Remarks="This operation can only be performed on int or uint typed resources and shared memory variables. There are two possible uses for this function. The first is when R is a shared memory variable type. In this case, the function performs an atomic XOR of value to the shared memory register referenced by dest. The second scenario is when R is a resource variable type. In this scenario, the function performs an atomic XORof value to the resource location referenced by dest. The overloaded function has an additional output variable which will be set to the original value of dest. This overloaded operation is only available when R is readable and writable.&#xD;&#xA;&#xD;&#xA;Interlocked operations do not imply any memory fence/barrier.">
          <p:NodeReference>
            <Choice Kind="ContainerDefinition" />
          </p:NodeReference>
