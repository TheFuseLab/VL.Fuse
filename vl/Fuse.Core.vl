    ************************ SoftLight ************************

-->
          <Node Name="SoftLight" Bounds="174,850" Id="H7aNuEbdovCMgzc9h7QWV5">
            <p:NodeReference LastCategoryFullName="Primitive" LastDependency="builtin">
              <Choice Kind="ContainerDefinition" Name="Process" />
            </p:NodeReference>
            <Patch Id="Q1NQbuEN1XCMxmf8LFCsNX" IsGeneric="true">
              <Canvas Id="OmxjRQ6a3DlLFVss65K0c0" CanvasType="Group">
                <Pad Id="RYHvCVF98vsMXyct0Fj8AN" Comment="" Bounds="92,141,491,131" ShowValueBox="true" isIOBox="true" Value="${resultType} ${signature}(${resultType} Base, ${resultType} Blend, ${resultType} Opacity)&#xD;&#xA;{&#xD;&#xA;    ${resultType} result1 = 2.0 * Base * Blend + Base * Base * (1.0 - 2.0 * Blend);&#xD;&#xA;    ${resultType} result2 = sqrt(Base) * (2.0 * Blend - 1.0) + 2.0 * Base * (1.0 - Blend);&#xD;&#xA;    ${resultType} zeroOrOne = step(0.5, Blend);&#xD;&#xA;    ${resultType} Out = result2 * zeroOrOne + (1 - zeroOrOne) * result1;&#xD;&#xA;    return lerp(Base, Out, Opacity);&#xD;&#xA;}">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
