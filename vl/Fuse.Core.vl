              <Pad Id="PnEMBGg21beP2uSQUfu0VN" Bounds="970,127,388,221" ShowValueBox="true" isIOBox="true" Value="float3 GenerateTangent(float3 normal)&#xD;&#xA;{&#xD;&#xA;    float3 tangent;&#xD;&#xA;    if (abs(normal.z) &lt; 0.999)&#xD;&#xA;        tangent = cross(normal, float3(0, 0, 1));&#xD;&#xA;    else&#xD;&#xA;        tangent = cross(normal, float3(1, 0, 0));&#xD;&#xA;&#xD;&#xA;    return normalize(tangent);&#xD;&#xA;}&#xD;&#xA;">
