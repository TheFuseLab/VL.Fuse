              <Node Bounds="80,192,120,19" Id="GdOhnJAHAFsPabb2x9MFIr">
                <p:NodeReference LastCategoryFullName="Fuse.Function" LastDependency="Fuse.Core.vl">
                  <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
                  <Choice Kind="ProcessAppFlag" Name="TypedIntrinsicFunction" />
                </p:NodeReference>
                <Pin Id="C2O23vGFQ5fOOO8JHxt3wI" Name="Node Context" Kind="InputPin" IsHidden="true" />
                <Pin Id="Aib6O35AMMAOvgdrXMgKeI" Name="Function" Kind="InputPin" />
