                <Pad Id="Nm2bwT210nzL2refAAxFKo" Bounds="1007,528,668,551" ShowValueBox="true" isIOBox="true" Value="// Mean Calculation Compute Shader&#xD;&#xA;StructuredBuffer&lt;uint&gt; histogram : register(t0);  // Input histogram buffer&#xD;&#xA;RWStructuredBuffer&lt;float&gt; meanResult : register(u0);  // Output mean buffer&#xD;&#xA;cbuffer MeanParams : register(b0)&#xD;&#xA;{&#xD;&#xA;    uint numBins;      // Number of histogram bins&#xD;&#xA;    uint totalPixels;  // Total number of pixels in the image&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;[numthreads(1, 1, 1)]&#xD;&#xA;void CSMain(uint3 DTid : SV_DispatchThreadID)&#xD;&#xA;{&#xD;&#xA;    float meanSum = 0;&#xD;&#xA;&#xD;&#xA;    // Compute the weighted sum of pixel intensities&#xD;&#xA;    for (uint i = 0; i &lt; numBins; i++)&#xD;&#xA;    {&#xD;&#xA;        meanSum += i * histogram[i];&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // Calculate the mean&#xD;&#xA;    float meanIntensity = meanSum / totalPixels;&#xD;&#xA;&#xD;&#xA;    // Store the result&#xD;&#xA;    meanResult[0] = meanIntensity / (numBins - 1);  // Normalize mean to [0, 1] range&#xD;&#xA;}">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
                  <p:ValueBoxSettings>
                    <p:fontsize p:Type="Int32">9</p:fontsize>
                    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                  </p:ValueBoxSettings>
                </Pad>
                <Pad Id="SuVokOZacYAN719EUhwZeY" Comment="Element Count" Bounds="387,489,35,15" ShowValueBox="true" isIOBox="true" Value="1">
