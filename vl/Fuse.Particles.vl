              <Pad Id="D6wmyG7kUK2NU1PUR4g0sJ" Bounds="831,407,409,270" ShowValueBox="true" isIOBox="true" Value="Particle IntegrateRK2VelocityField(Particle p, float dt, float t)&#xD;&#xA;{&#xD;&#xA;    // k1&#xD;&#xA;    float3 k1 = VelocityField(p.position, t);&#xD;&#xA;&#xD;&#xA;    // Midpoint&#xD;&#xA;    float3 midPos = p.position + 0.5f * dt * k1;&#xD;&#xA;    float3 k2 = VelocityField(midPos, t + 0.5f * dt);&#xD;&#xA;&#xD;&#xA;    // Final&#xD;&#xA;    p.position += dt * k2;&#xD;&#xA;    return p;&#xD;&#xA;}&#xD;&#xA;">
