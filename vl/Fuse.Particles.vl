    ************************ RungeKutta4Accel (Region) ************************

-->
        <Node Name="RungeKutta4Accel (Region)" Aspects="Internal" Bounds="249,830" Id="FjkHd8xJH6RQUSOYpWlk0i">
          <p:NodeReference>
            <Choice Kind="ClassDefinition" Name="Class" />
            <CategoryReference Kind="Category" Name="Primitive" />
          </p:NodeReference>
          <p:Interfaces>
            <TypeReference LastCategoryFullName="Fuse.Particles.Integration" LastDependency="Fuse.Particles.vl">
              <Choice Kind="InterfaceTypeFlag" Name="IIntegrator" />
            </TypeReference>
          </p:Interfaces>
          <Patch Id="T6o7UWWfl37Ltl7JPpLzaB" IsGeneric="true">
            <Canvas Id="L8XT0rJWoK7NGpfXruGBzL" CanvasType="Group">
              <ControlPoint Id="PJQBJFtYan7LWGDoUlPujt" Bounds="739,2172" />
              <Pad Id="LgIVeTANa8gNpFQY1zajLA" Bounds="1334,303,495,666" ShowValueBox="true" isIOBox="true" Value="// Performs one RK4 integration step.&#xD;&#xA;Particle IntegrateRK4(Particle p, float dt, float t)&#xD;&#xA;{&#xD;&#xA;    // k1&#xD;&#xA;    float3 k1_x = p.velocity;&#xD;&#xA;    float3 k1_v = ComputeAcceleration(p.position, p.velocity, t);&#xD;&#xA;&#xD;&#xA;    // k2&#xD;&#xA;    float3 pos_k2 = p.position + 0.5f * dt * k1_x;&#xD;&#xA;    float3 vel_k2 = p.velocity + 0.5f * dt * k1_v;&#xD;&#xA;    float3 k2_x   = vel_k2;&#xD;&#xA;    float3 k2_v   = ComputeAcceleration(pos_k2, vel_k2, t + 0.5f * dt);&#xD;&#xA;&#xD;&#xA;    // k3&#xD;&#xA;    float3 pos_k3 = p.position + 0.5f * dt * k2_x;&#xD;&#xA;    float3 vel_k3 = p.velocity + 0.5f * dt * k2_v;&#xD;&#xA;    float3 k3_x   = vel_k3;&#xD;&#xA;    float3 k3_v   = ComputeAcceleration(pos_k3, vel_k3, t + 0.5f * dt);&#xD;&#xA;&#xD;&#xA;    // k4&#xD;&#xA;    float3 pos_k4 = p.position + dt * k3_x;&#xD;&#xA;    float3 vel_k4 = p.velocity + dt * k3_v;&#xD;&#xA;    float3 k4_x   = vel_k4;&#xD;&#xA;    float3 k4_v   = ComputeAcceleration(pos_k4, vel_k4, t + dt);&#xD;&#xA;&#xD;&#xA;    // Combine the results&#xD;&#xA;    // position&#xD;&#xA;    float3 newPos = p.position &#xD;&#xA;                    + (dt / 6.0f) * (k1_x + 2.0f * k2_x + 2.0f * k3_x + k4_x);&#xD;&#xA;    // velocity&#xD;&#xA;    float3 newVel = p.velocity&#xD;&#xA;                    + (dt / 6.0f) * (k1_v + 2.0f * k2_v + 2.0f * k3_v + k4_v);&#xD;&#xA;&#xD;&#xA;    // Return updated particle&#xD;&#xA;    Particle result;&#xD;&#xA;    result.position = newPos;&#xD;&#xA;    result.velocity = newVel;&#xD;&#xA;    return result;&#xD;&#xA;}&#xD;&#xA;">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
                <p:ValueBoxSettings>
                  <p:fontsize p:Type="Int32">9</p:fontsize>
                  <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                </p:ValueBoxSettings>
              </Pad>
