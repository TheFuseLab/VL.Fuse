              <Pad Id="KU75DpEturyL4ypYtRrLp5" Bounds="693,168,606,361" ShowValueBox="true" isIOBox="true" Value="// Performs one Leapfrog integration step&#xD;&#xA;Particle IntegrateLeapfrog(Particle p, float dt, float t) {&#xD;&#xA;    // First, update velocity by half a timestep&#xD;&#xA;    // v(t + dt/2) = v(t) + a(t)*dt/2&#xD;&#xA;    float3 halfStepVel = p.velocity + 0.5f * dt * ComputeAcceleration(p.position, p.velocity, t);&#xD;&#xA;    &#xD;&#xA;    // Then update position using this half-step velocity&#xD;&#xA;    // x(t + dt) = x(t) + v(t + dt/2)*dt&#xD;&#xA;    float3 newPos = p.position + dt * halfStepVel;&#xD;&#xA;    &#xD;&#xA;    // Finally, update velocity to the full step&#xD;&#xA;    // v(t + dt) = v(t + dt/2) + a(t + dt)*dt/2&#xD;&#xA;    float3 newVel = halfStepVel + 0.5f * dt * ComputeAcceleration(newPos, halfStepVel, t + dt);&#xD;&#xA;    &#xD;&#xA;    Particle result;&#xD;&#xA;    result.position = newPos;&#xD;&#xA;    result.velocity = newVel;&#xD;&#xA;    return result;&#xD;&#xA;}">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
                <p:ValueBoxSettings>
                  <p:fontsize p:Type="Int32">9</p:fontsize>
                  <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                </p:ValueBoxSettings>
              </Pad>
