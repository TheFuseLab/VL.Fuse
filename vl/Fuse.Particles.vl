        <Node Name="RungeKutta4Forward (Region)" Bounds="249,586" Id="BbcmX2QaAptMkdTkKGv3xv">
          <p:NodeReference>
            <Choice Kind="ClassDefinition" Name="Class" />
            <CategoryReference Kind="Category" Name="Primitive" />
          </p:NodeReference>
          <p:Interfaces>
            <TypeReference LastCategoryFullName="Fuse.Particles.Integration" LastDependency="Fuse.Particles.vl">
              <Choice Kind="InterfaceTypeFlag" Name="IIntegrator" />
            </TypeReference>
          </p:Interfaces>
          <Patch Id="Q6Lqwv5r4dIQDuaY88zjgE">
            <Canvas Id="EJkDH3kN8dcNDOO4Vx0bwM" CanvasType="Group">
              <Pad Id="Qgl7VX5pakBMPtU9Ga9XlI" Bounds="1150,443,432,453" ShowValueBox="true" isIOBox="true" Value="Particle IntegrateRK4VelocityField(Particle p, float dt, float t)&#xD;&#xA;{&#xD;&#xA;    // k1&#xD;&#xA;    float3 k1 = VelocityField(p.position, t);&#xD;&#xA;&#xD;&#xA;    // k2&#xD;&#xA;    float3 pos_k2 = p.position + 0.5f * dt * k1;&#xD;&#xA;    float3 k2 = VelocityField(pos_k2, t + 0.5f * dt);&#xD;&#xA;&#xD;&#xA;    // k3&#xD;&#xA;    float3 pos_k3 = p.position + 0.5f * dt * k2;&#xD;&#xA;    float3 k3 = VelocityField(pos_k3, t + 0.5f * dt);&#xD;&#xA;&#xD;&#xA;    // k4&#xD;&#xA;    float3 pos_k4 = p.position + dt * k3;&#xD;&#xA;    float3 k4 = VelocityField(pos_k4, t + dt);&#xD;&#xA;&#xD;&#xA;    // Combine&#xD;&#xA;    float3 sum = k1 + 2.0f*k2 + 2.0f*k3 + k4;&#xD;&#xA;    p.position += (dt / 6.0f) * sum;&#xD;&#xA;&#xD;&#xA;    return p;&#xD;&#xA;}&#xD;&#xA;">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
                <p:ValueBoxSettings>
                  <p:fontsize p:Type="Int32">9</p:fontsize>
                  <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                </p:ValueBoxSettings>
              </Pad>
