        <Node Name="EulerAccel" Aspects="Internal" Bounds="523,553" Id="JLVtVirLYZFNlgKYeSvrdO">
          <p:NodeReference>
            <Choice Kind="ContainerDefinition" Name="Process" />
            <CategoryReference Kind="Category" Name="Primitive" />
          </p:NodeReference>
          <Patch Id="Hu3dHu4RqAuLh8DoUCrXDN" IsGeneric="true">
            <Canvas Id="Db4iD7Khh9CPfl9NXF1H3w" CanvasType="Group">
              <Pad Id="EcyTKEue4g0MEt5kqTfG8q" Bounds="166,97,290,19" ShowValueBox="true" isIOBox="true" Value="#define calcEulerV3(f, p, dT)  ( p += f(p) * dT )  ">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
                <p:ValueBoxSettings>
                  <p:fontsize p:Type="Int32">9</p:fontsize>
                  <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                </p:ValueBoxSettings>
