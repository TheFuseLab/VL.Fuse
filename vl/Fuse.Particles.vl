          <p:Interfaces>
            <TypeReference LastCategoryFullName="Fuse.Particles.Integration" LastDependency="Fuse.Particles.vl">
              <Choice Kind="InterfaceTypeFlag" Name="IIntegrator" />
            </TypeReference>
          </p:Interfaces>
          <Patch Id="AlTwWWoNxLGP5KodrxqHR0">
            <Canvas Id="S19AjlZqMXrMYjZO2G0X9x" CanvasType="Group">
              <Pad Id="VXsNTjVjfoFQQEZbxkEynQ" Bounds="585,172,1463,434" ShowValueBox="true" isIOBox="true" Value="&#xD;&#xA;&#xD;&#xA;// Velocity Verlet - more stable, explicitly tracks velocity&#xD;&#xA;Particle IntegrateVelocityVerlet(Particle p, float dt, float t) {&#xD;&#xA;    // First half: Update position and half-step velocity&#xD;&#xA;    float3 acceleration = ComputeAcceleration(p.position, p.velocity, t);&#xD;&#xA;    &#xD;&#xA;    // Update position: x(t + dt) = x(t) + v(t)*dt + 1/2*a(t)*dt^2&#xD;&#xA;    float3 newPos = p.position + p.velocity * dt + 0.5f * acceleration * dt * dt;&#xD;&#xA;    &#xD;&#xA;    // Get acceleration at new position&#xD;&#xA;    float3 newAcceleration = ComputeAcceleration(newPos, p.velocity, t + dt);&#xD;&#xA;    &#xD;&#xA;    // Update velocity: v(t + dt) = v(t) + 1/2*(a(t) + a(t + dt))*dt&#xD;&#xA;    float3 newVel = p.velocity + 0.5f * (acceleration + newAcceleration) * dt;&#xD;&#xA;    &#xD;&#xA;    Particle result;&#xD;&#xA;    result.position = newPos;&#xD;&#xA;    result.velocity = newVel;&#xD;&#xA;    return result;&#xD;&#xA;}">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
                <p:ValueBoxSettings>
                  <p:fontsize p:Type="Int32">9</p:fontsize>
                  <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                </p:ValueBoxSettings>
              </Pad>
