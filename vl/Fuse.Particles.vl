              <Node Bounds="253,180,40,19" Id="M576Te8RCIZP66aPX8lla7">
                <p:NodeReference LastCategoryFullName="Fuse.Math" LastDependency="VL.Fuse.vl">
                  <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
