                </p:NodeReference>
                <Pin Id="TC3gasIkarVMXXnbpqEsfP" Name="Output" Kind="OutputPin" />
                <Pin Id="UVB1GJ4ton8QJfFE3fwkI1" Name="Node Context" Kind="InputPin" IsHidden="true" />
              </Node>
              <Pad Id="DFlzO6stWLyNQri2OGZT6E" Bounds="646,151,619,472" ShowValueBox="true" isIOBox="true" Value="&#xD;&#xA;&#xD;&#xA;// Performs one RK2 (midpoint) integration step.&#xD;&#xA;Particle IntegrateRK2(Particle p, float dt, float t)&#xD;&#xA;{&#xD;&#xA;    // k1 evaluation&#xD;&#xA;    float3 k1_x = p.velocity;                             // derivative of position is velocity&#xD;&#xA;    float3 k1_v = ComputeAcceleration(p.position, p.velocity, t);&#xD;&#xA;&#xD;&#xA;    // Midpoint state&#xD;&#xA;    float3 posMid = p.position + 0.5f * dt * k1_x;&#xD;&#xA;    float3 velMid = p.velocity + 0.5f * dt * k1_v;&#xD;&#xA;&#xD;&#xA;    // k2 evaluation&#xD;&#xA;    float3 k2_x = velMid;&#xD;&#xA;    float3 k2_v = ComputeAcceleration(posMid, velMid, t + 0.5f * dt);&#xD;&#xA;&#xD;&#xA;    // Final update for this timestep&#xD;&#xA;    Particle result;&#xD;&#xA;    result.position = p.position + dt * k2_x;&#xD;&#xA;    result.velocity = p.velocity + dt * k2_v;&#xD;&#xA;&#xD;&#xA;    return result;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;">
                <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                  <Choice Kind="TypeFlag" Name="String" />
                </p:TypeAnnotation>
                <p:ValueBoxSettings>
                  <p:fontsize p:Type="Int32">9</p:fontsize>
                  <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                </p:ValueBoxSettings>
              </Pad>
