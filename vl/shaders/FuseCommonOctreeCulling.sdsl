shader FuseCommonOctreeCulling{
    // GPU-driven Octree Culling and LOD Selection
    // - Multi-frustum, plane-based
    // - Per-frustum FocalY + ViewportHeight via FrustumProjParams

    //--------------------------------------------------------------------------------------
    // Data Structures - Must EXACTLY match the C# struct definitions
    //--------------------------------------------------------------------------------------

    struct GPUOctreeNode
    {
        float3 BoundsMin;
        float  BoundsSize;
        float3 BoundsMax;
        uint   ChildStartIndex;
        uint   IndexStartIndex;
        uint   IndexCount;
        uint   LODLevel;
        uint   ParentIndex;
    };

    //--------------------------------------------------------------------------------------
    // Helper Functions
    //--------------------------------------------------------------------------------------

    // Approximate screen-space size in pixels (1D size along Y)
    // focalY: typically 1 / tan(FovY * 0.5)
    float ApproxScreenSpaceSize(
        float3 boundsCenter,
        float  boundsSize,
        float3 CameraPositionWS,
        float  focalY,
        float  ViewportHeight)
    {
        float dist = distance(boundsCenter, CameraPositionWS);
        dist = max(dist, 0.0001f);

        // approximate: screenSize ≈ (size / dist) * focalY * 0.5 * ViewportHeight
        return (boundsSize / dist) * focalY * 0.5f * ViewportHeight;
    }

    // Validate node bounds
    bool IsValidNode(GPUOctreeNode node)
    {
        return node.BoundsMin.x <= node.BoundsMax.x && 
               node.BoundsMin.y <= node.BoundsMax.y && 
               node.BoundsMin.z <= node.BoundsMax.z &&
               node.BoundsSize  > 0.0f;
    }

    // --- Internal helper: test AABB (given center/extents) against a single frustum ---
    //
    // planes for this frustum start at frustumPlanes[baseIndex + 0 .. baseIndex + PlanesPerFrustum-1]
    //
    // Returns:
    //   0 = outside
    //   1 = intersecting
    //   2 = inside
    uint TestAABBFrustumSingleCenter(
        float3 center,
        float3 extents,
        StructuredBuffer<float4> frustumPlanes,
        int baseIndex,
        int PlanesPerFrustum,
        float Margin)     // world-space margin for side planes only
    {
        uint result = 2; // assume fully inside

        [loop]
        for (int i = 0; i < PlanesPerFrustum; ++i)
        {
            float4 plane = frustumPlanes[baseIndex + i];

            float planeLength = length(plane.xyz);
            if (planeLength > 0.0001f)
                plane /= planeLength;

            float distance = dot(float4(center, 1.0f), plane);
            float radius   = dot(extents, abs(plane.xyz));

            // Decide which planes get margin:
            // assuming layout: 0=L,1=R,2=B,3=T,4=Near,5=Far
            bool isNearOrFar = (i >= (PlanesPerFrustum - 2));
            float planeMargin = isNearOrFar ? 0.0f : Margin;

            // Outside test: expand only side planes
            if (distance < -radius - planeMargin)
            {
                return 0; // outside
            }

            // Intersection band: also only widened for side planes
            if (abs(distance) < radius + planeMargin)
            {
                result = 1; // intersecting
            }
        }

        return result; // 0=outside, 1=intersect, 2=inside
    }


    // PUBLIC: test against a single frustum (by index) – pure culling
    uint TestAABBFrustumSingle(
        float3 boundsMin,
        float3 boundsMax,
        StructuredBuffer<float4> frustumPlanes,
        int PlanesPerFrustum,
        float Margin,
        int FrustumIndex)
    {
        float3 center  = (boundsMax + boundsMin) * 0.5f;
        float3 extents = (boundsMax - boundsMin) * 0.5f;

        int baseIndex = FrustumIndex * PlanesPerFrustum;
        return TestAABBFrustumSingleCenter(
            center,
            extents,
            frustumPlanes,
            baseIndex,
            PlanesPerFrustum,
            Margin);
    }

    // Combined multi-frustum culling + LOD evaluation:
    //
    // - Uses frustumPlanes for culling
    // - Uses FrustumProjParams[f] = (FocalY, ViewportHeight) for screen-space size
    //
    // Returns:
    //   frustumTest: 0=outside all, 1=intersecting at least one, 2=inside at least one
    //   maxScreenSize: max screen size across all frustums where res != 0
    void EvaluateNodeMultiFrustumLOD(
        float3 boundsMin,
        float3 boundsMax,
        float  boundsSize,
        StructuredBuffer<float4> frustumPlanes,
        StructuredBuffer<float2> FrustumProjParams,
        int    FrustumCount,
        int    PlanesPerFrustum,
        float Margin,
        float3 CameraPositionWS,
        out uint  frustumTest,
        out float maxScreenSize)
    {
        float3 center  = (boundsMax + boundsMin) * 0.5f;
        float3 extents = (boundsMax - boundsMin) * 0.5f;

        frustumTest   = 0;
        maxScreenSize = 0.0f;

        [loop]
        for (int f = 0; f < FrustumCount; ++f)
        {
            int baseIndex = f * PlanesPerFrustum;

            uint res = TestAABBFrustumSingleCenter(
                center,
                extents,
                frustumPlanes,
                baseIndex,
                PlanesPerFrustum,
                Margin);

            if (res == 0)
            {
                // outside this frustum
                continue;
            }

            // Update visibility classification
            if (res == 2)
            {
                // inside this frustum
                if (frustumTest != 2)
                    frustumTest = 2;
            }
            else // res == 1
            {
                if (frustumTest == 0)
                    frustumTest = 1;
            }

            // Now LOD for this frustum: use its FocalY + ViewportHeight
            float2 projParams    = FrustumProjParams[f];
            float  focalY        = projParams.x;
            float  viewportHeight = projParams.y;

            float screenSize = ApproxScreenSpaceSize(
                center,
                boundsSize,
                CameraPositionWS,
                focalY,
                viewportHeight);

            maxScreenSize = max(maxScreenSize, screenSize);
        }
    }

    // Simple 32-bit hash, SDsl friendly
    int Hash32i(int v)
    {
        v = v ^ (v << 13);
        v = v ^ (v >> 17);
        v = v ^ (v << 5);
        if (v < 0) v = -v;
        return v;
    }

    //======================================================================================
    // PASS 1 FUNCTION: GENERATE WORK ITEMS - multi-frustum + per-frustum proj params
    //======================================================================================
    void GenerateWorkItems(
        StructuredBuffer<float4>        frustumPlanes,
        StructuredBuffer<float2>        FrustumProjParams, // x=FocalY, y=ViewportHeight
        int                             FrustumCount,
        int                             PlanesPerFrustum,
        float                           Margin,
        float3                          CameraPositionWS, 
        float                           LODScreenSpaceThreshold, 
        int                             MinWorkItemDepth,
        int                             startID,
        StructuredBuffer<GPUOctreeNode> GpuOctreeNodes,
        RWStructuredBuffer<int>         WorkItems, 
        RWStructuredBuffer<int>         WorkItemCounter
    )
    {
        int nodeStack[1024];
        int stackTop = 0;
        
        if (startID >= 0)
        {
            nodeStack[stackTop++] = startID;
        }
        
        while (stackTop > 0 && stackTop < 1024)
        {
            int nodeID = nodeStack[--stackTop];
            GPUOctreeNode node = GpuOctreeNodes[nodeID];
            
            if (!IsValidNode(node))
                continue;

            uint  frustumTest;
            float screenSize;

            EvaluateNodeMultiFrustumLOD(
                node.BoundsMin,
                node.BoundsMax,
                node.BoundsSize,
                frustumPlanes,
                FrustumProjParams,
                FrustumCount,
                PlanesPerFrustum,
                Margin,
                CameraPositionWS,
                frustumTest,
                screenSize);

            if (frustumTest == 0)
            {
                // outside all frustums
                continue;
            }

            // Leaf node → direct work item
            bool isLeaf = (node.ChildStartIndex == 0xFFFFFFFF || node.ChildStartIndex == -1);
            if (isLeaf)
            {
                if (node.IndexCount > 0)
                {
                    uint writeIndex;
                    InterlockedAdd(WorkItemCounter[0], 1, writeIndex);
                    WorkItems[writeIndex] = nodeID;
                }
                continue;
            }

            // LOD decision using screenSize (max across frustums)
            bool shouldTraverseDeeper =
                (screenSize > LODScreenSpaceThreshold * 2.0f) &&
                (node.LODLevel < MinWorkItemDepth + 3);

            bool canCreateWorkItem =
                (node.LODLevel >= MinWorkItemDepth) &&
                (frustumTest == 2 || screenSize <= LODScreenSpaceThreshold * 4.0f);
            
            if (shouldTraverseDeeper)
            {
                // Add children to stack for deeper traversal
                for (uint i = 0; i < 8; ++i)
                {
                    if (stackTop < 1023)
                    {
                        nodeStack[stackTop++] = node.ChildStartIndex + i;
                    }
                }
            }
            else if (canCreateWorkItem)
            {
                // Create work item for this internal node
                uint writeIndex;
                InterlockedAdd(WorkItemCounter[0], 1, writeIndex);
                WorkItems[writeIndex] = nodeID;
            }
            else
            {
                // Default: add children if we can't decide
                for (uint i = 0; i < 8; ++i)
                {
                    if (stackTop < 1023)
                    {
                        nodeStack[stackTop++] = node.ChildStartIndex + i;
                    }
                }
            }
        }
    }

    //======================================================================================
    // PASS 2 FUNCTION: PROCESS WORK ITEMS AND SELECT FOR LOD - multi-frustum + per-frustum proj params
    //======================================================================================
    void ProcessWorkItem_AndSelectLOD(
        int                             globalThreadID,
        StructuredBuffer<float4>        frustumPlanes,
        StructuredBuffer<float2>        FrustumProjParams,
        int                             FrustumCount,
        int                             PlanesPerFrustum,
        float                           Margin,
        float3                          CameraPositionWS, 
        float                           LODScreenSpaceThreshold, 
        RWStructuredBuffer<int>         WorkItems, 
        RWStructuredBuffer<int>         WorkItemCounter, 
        StructuredBuffer<GPUOctreeNode> GpuOctreeNodes,
        RWStructuredBuffer<int>         VisibleNodeIDs, 
        RWStructuredBuffer<int>         VisibleNodeCounter,
        RWStructuredBuffer<int>         TotalPointCounter
    )
    {
        int numWorkItems = WorkItemCounter[0];
        if (globalThreadID >= numWorkItems) return;

        int workNodeID = WorkItems[globalThreadID];

        int nodeStack[512];
        int stackTop = 0;
        nodeStack[stackTop++] = workNodeID;

        while (stackTop > 0 && stackTop < 512)
        {
            int nodeID = nodeStack[--stackTop];
            GPUOctreeNode node = GpuOctreeNodes[nodeID];

            if (!IsValidNode(node))
                continue;

            uint  frustumTest;
            float screenSize;

            EvaluateNodeMultiFrustumLOD(
                node.BoundsMin,
                node.BoundsMax,
                node.BoundsSize,
                frustumPlanes,
                FrustumProjParams,
                FrustumCount,
                PlanesPerFrustum,
                Margin,
                CameraPositionWS,
                frustumTest,
                screenSize);

            if (frustumTest == 0)
                continue; // outside all frustums

            // Too small for this LOD
            if (screenSize < LODScreenSpaceThreshold * 0.5f)
                continue;

            bool isLeaf = (node.ChildStartIndex == 0xFFFFFFFF || node.ChildStartIndex == -1);

            // Leaf node → directly visible
            if (isLeaf)
            {
                if (node.IndexCount > 0)
                {
                    uint writeIndex;
                    InterlockedAdd(VisibleNodeCounter[0], 1, writeIndex);
                    InterlockedAdd(TotalPointCounter[0], node.IndexCount);
                    VisibleNodeIDs[writeIndex] = nodeID;
                }
            }
            else
            {
                // Internal node: decide whether to traverse deeper or render this LOD level
                if (screenSize > LODScreenSpaceThreshold * 2.0f)
                {
                    for (int i = 0; i < 8; ++i)
                    {
                        if (stackTop < 511)
                        {
                            nodeStack[stackTop++] = node.ChildStartIndex + i;
                        }
                    }
                }
                else
                {
                    // Render at this LOD level – collect leaf descendants
                    int lodStack[256];
                    int lodStackTop = 0;
                    lodStack[lodStackTop++] = nodeID;
                    
                    while (lodStackTop > 0 && lodStackTop < 256)
                    {
                        int lodNodeID = lodStack[--lodStackTop];
                        GPUOctreeNode lodNode = GpuOctreeNodes[lodNodeID];

                        bool lodIsLeaf = (lodNode.ChildStartIndex == 0xFFFFFFFF || lodNode.ChildStartIndex == -1);

                        if (lodIsLeaf)
                        {
                            if (lodNode.IndexCount > 0)
                            {
                                uint writeIndex;
                                InterlockedAdd(VisibleNodeCounter[0], 1, writeIndex);
                                InterlockedAdd(TotalPointCounter[0], lodNode.IndexCount);
                                VisibleNodeIDs[writeIndex] = lodNodeID;
                            }
                        }
                        else
                        {
                            for (int j = 0; j < 8; ++j)
                            {
                                if (lodStackTop < 255)
                                {
                                    lodStack[lodStackTop++] = lodNode.ChildStartIndex + j;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    //======================================================================================
    // PASS 3 FUNCTION: COLLECT POINT INDICES (unchanged)
    //======================================================================================
    void CollectPointIndices(
        int                             globalThreadID,
        int                             MaxPointBudget,
        StructuredBuffer<GPUOctreeNode> allNodes,
        StructuredBuffer<int>           allLodIndices,
        int                             allLodIndicesLength,
        RWStructuredBuffer<int>         visibleNodeIds,
        RWStructuredBuffer<int>         visibleNodeCounter,
        RWStructuredBuffer<int>         finalIndices,
        int                             finalIndicesLength,
        RWStructuredBuffer<int>         finalCounter,
        RWStructuredBuffer<int>         TotalPointCounter)
    {
        int numVisibleNodes = visibleNodeCounter[0];
        if (globalThreadID >= numVisibleNodes) return;

        int nodeID = visibleNodeIds[globalThreadID];
        GPUOctreeNode node = allNodes[nodeID];
        if (node.IndexCount <= 0) return;

        int totalPoints = TotalPointCounter[0];

        int targetPointsForThisNode;
        if (MaxPointBudget > 0 && totalPoints > MaxPointBudget)
        {
            float nodeRatio = (float)node.IndexCount / (float)totalPoints;
            targetPointsForThisNode = max(1, (int)floor(nodeRatio * (float)MaxPointBudget + 0.5));
            targetPointsForThisNode = min(targetPointsForThisNode, (int)node.IndexCount);
        }
        else
        {
            targetPointsForThisNode = (int)node.IndexCount;
        }

        if (targetPointsForThisNode <= 0) return;

        int capacity = (MaxPointBudget > 0) ? MaxPointBudget : finalIndicesLength;

        // Reserve slots atomically. targetPointsForThisNode is deterministic
        // per node (derived from the fixed ratio), so every node always
        // requests the same count regardless of thread scheduling.
        uint baseIndex;
        InterlockedAdd(finalCounter[0], targetPointsForThisNode, baseIndex);

        if ((int)baseIndex >= capacity) return;

        int writable = min(targetPointsForThisNode, capacity - (int)baseIndex);
        if (writable <= 0) return;

        int nodeCount = (int)node.IndexCount;
        int start     = (int)node.IndexStartIndex;
        int maxSrc    = min(start + nodeCount, allLodIndicesLength);

        // Golden-ratio quasi-random sampling for temporal stability.
        // Unlike stride+hash, changing writable by ±N only adds/removes
        // the last N points in the sequence — earlier selections don't shift.
        float invPhi    = 0.6180339887; // 1 / golden ratio
        float nodePhase = frac((float)Hash32i(nodeID) * 0.0000076534);

        [loop]
        for (int k = 0; k < writable; ++k)
        {
            float t = frac(nodePhase + (float)(k + 1) * invPhi);
            int   i = (int)(t * (float)nodeCount);
            i = clamp(i, 0, nodeCount - 1);

            int addr = start + i;
            if (addr >= 0 && addr < maxSrc)
            {
                int pointID = allLodIndices[addr];
                finalIndices[baseIndex + k] = pointID;
            }
        }
    }
};
