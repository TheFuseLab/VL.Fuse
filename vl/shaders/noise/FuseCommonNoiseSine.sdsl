shader FuseCommonNoiseSine: FuseCommonNoise, FuseCoreMath, FuseCoreMathHash
{
	////////////////////////////////////////////////////////////////
	//
	//          Sine Basis
	// 
	////////////////////////////////////////////////////////////////

	// just for study, but can in fact be a usefel cheap basis.  

	// 1D
	float sineNoise (float p)
	{
		return sin(p*2.);
	}

	// 2D
	float sineNoise (float2 p)
	{
		float2 s = sin(p*2.);
		return sumComponent(s) * .5;


		// trying out something less regular
		/*
		int iter = 4;
		float2 n = 0.;
		for(int i=0; i < iter; i++)
		{
			float2 fm = hash22(float(i) * float2(34.7,93.27));
			float2 am = hash22(float(i) * float2(542.98,73.82));
			n += sin(p * fm) * am;
		}
		n /= float(iter);
		return (n.x + n.y) * .5;
		*/
	}

	// 3D
	float sineNoise (float3 p)
	{
		float3 s = sin(p*2.);
		return sumComponent(s) * .33333333333333;
	}

	// 4D
	float sineNoise (float4 p)
	{
		float4 s = sin(p*2.);
		return sumComponent(s) * .25;
	}

	// 3D with gradient
	// TODO Replace with analytic 
	float4 sineNoiseGrad (float3 p)
	{
		float n = sineNoise(p);
		float3  result = n.xxx;
		float e = 0.001;
		for(int i = 0; i < 3; i++) 		// just a weird ass way of writing forward difference
		{
			float3 offset = .0;
			offset[i] = e;
			result[i] = (sineNoise(p + offset) -  result[i]) /  e;
		}
	   return float4(n, result);

	}

	////////////////////////////////////////////////////////////////
	//
	//          1D to 4D Input/Output Variants
	// 
	////////////////////////////////////////////////////////////////

	// 1D Output
	float sineNoise11 (float p)
	{ return sineNoise(p); }

	float sineNoise12 (float2 p)
	{ return sineNoise(p); }

	float sineNoise13 (float3 p)
	{ return sineNoise(p); }

	float sineNoise14 (float4 p)
	{ return sineNoise(p); }

	// 2D Output
	float2 sineNoise21 (float p)
	{
		float p2;
		noiseDomainOffset(p, p2);
		return float2(sineNoise(p), sineNoise(p2));
	}

	float2 sineNoise22 (float2 p)
	{
		float2 p2;
		noiseDomainOffset(p, p2);
		return float2(sineNoise(p), sineNoise(p2));
	}

	float2 sineNoise23 (float3 p)
	{
		float3 p2;
		noiseDomainOffset(p, p2);
		return float2(sineNoise(p), sineNoise(p2));
	}

	float2 sineNoise24 (float4 p)
	{
		float4 p2;
		noiseDomainOffset(p, p2);
		return float2(sineNoise(p), sineNoise(p2));
	}

	// 3D Output
	float3 sineNoise31 (float p)
	{
		float p2, p3;
		noiseDomainOffset(p, p2, p3);
		return float3(sineNoise(p), sineNoise(p2), sineNoise(p3));
	}

	float3 sineNoise32 (float2 p)
	{
		float2 p2, p3; 
		noiseDomainOffset(p, p2, p3);
		return float3(sineNoise(p), sineNoise(p2), sineNoise(p3));
	}

	float3 sineNoise33 (float3 p)
	{
		float3 p2, p3;
		noiseDomainOffset(p, p2, p3);
		return float3(sineNoise(p), sineNoise(p2), sineNoise(p3));
	}

	float3 sineNoise34 (float4 p)
	{
		float4 p2, p3;
		noiseDomainOffset(p, p2, p3);
		return float3(sineNoise(p), sineNoise(p2), sineNoise(p3));
	}

	// 4D Output
	float4 sineNoise41(float p)
	{
		float p2, p3, p4;
		noiseDomainOffset(p, p2, p3, p4);
		return float4(sineNoise(p), sineNoise(p2), sineNoise(p3), sineNoise(p4));
	}

	float4 sineNoise42(float2 p)
	{
		float2 p2, p3, p4;
		noiseDomainOffset(p, p2, p3, p4);
		return float4(sineNoise(p), sineNoise(p2), sineNoise(p3), sineNoise(p4));
	}

	float4 sineNoise43(float3 p)
	{
		float3 p2, p3, p4;
		noiseDomainOffset(p, p2, p3, p4);
		return float4(sineNoise(p), sineNoise(p2), sineNoise(p3), sineNoise(p4));
	}

	float4 sineNoise44(float4 p)
	{
		float4 p2, p3, p4;
		noiseDomainOffset(p, p2, p3, p4);
		return float4(sineNoise(p), sineNoise(p2), sineNoise(p3), sineNoise(p4));
	}

	////////////////////////////////////////////////////////////////
	//
	//          Divergence-Free Vector Field
	// 
	////////////////////////////////////////////////////////////////

	float3 sineNoiseDFV(float3 p)
	{
	    float4 n1 = sineNoiseGrad(p);
		float4 n2 = sineNoiseGrad(p+vectorValuedNoiseOffsets);
		return cross(n1.yzw, n2.yzw);
	}

};
