// ============================================================================
// OpticalFlowLib: condensed mixin for coarse-to-fine Horn–Schunck style flow
// ----------------------------------------------------------------------------
// Contains three main compute kernels as functions:
//
//   1) Derivatives_Compute
//        - Builds (Ix, Iy, It) from two input frames.
//
//   2) HSGroup_Compute
//        - Performs LOCAL_ITER Horn–Schunck iterations on a tile using
//          groupshared memory (fast, tiled smoothing).
//
//   3) Warp_Compute
//        - Warps one frame using a flow field.
//
// All functions are in a single mixin and take *all resources/params as
// arguments*. No cbuffers or uniforms are defined inside the mixin.
// You provide those when you wrap them in a shader.
//
// ============================================================================

shader  FuseComputeOpticalFlow
{
    

    // ------------------------------------------------------------
    // Helper: RGB -> Luminance
    // ------------------------------------------------------------
    float OpticalFlow_Luma(float3 rgb)
    {
        // Standard Rec.601; adjust if needed
        return dot(rgb, float3(0.299, 0.587, 0.114));
    }

    // ------------------------------------------------------------
    // KERNEL: PreprocessImage
    // Run this ONCE on the raw input frame before generating Mips.
    // ------------------------------------------------------------
    void PreprocessImage(
        int2                    pixel,
        int2                    levelSize,
        Texture2D<float4>       src,             // Current Raw Frame
        Texture2D<float4>       srcPrev,         // Previous Raw Frame
        RWTexture2D<float4>     outTex,          // Output (Grayscale)
        SamplerState            samp,
        float                   blurStrength,    // 0.0 - 1.0
        float                   contrastBoost,   // 0.0 = None, 1.0 = High
        float                   lightingInvariance, // 0.0 = Off, 1.0 = Remove Shadows
        float                   temporalSmoothing)  // 0.0 = Off, 0.5 = Balanced
    {
        // 0. Bounds Check
        if (pixel.x < 0 || pixel.x >= levelSize.x ||
            pixel.y < 0 || pixel.y >= levelSize.y)
            return;

        float2 size = float2(levelSize);
        float2 uv   = (float2(pixel) + 0.5) / size;
        float2 texel = 1.0 / size;

        // ------------------------------------------------------------
        // 1. Center Pixel (Temporally Smoothed)
        // ------------------------------------------------------------
        float4 cCur  = src.SampleLevel(samp, uv, 0.0);
        float4 cPrev = srcPrev.SampleLevel(samp, uv, 0.0);
        float4 c     = lerp(cCur, cPrev, temporalSmoothing);
        
        float L = OpticalFlow_Luma(c.rgb);

        // ------------------------------------------------------------
        // 2. Spatial Smoothing (3x3 Gaussian)
        // Fix: Neighbors are also temporally smoothed to match the center.
        // ------------------------------------------------------------
        float L_blur = 0.0;
        const float k[9] = { 1, 2, 1, 2, 4, 2, 1, 2, 1 };

        int idx = 0;
        for (int j = -1; j <= 1; j++)
        {
            for (int i = -1; i <= 1; i++)
            {
                float2 uv2 = uv + float2(i, j) * texel;
                
                // Sample both frames at neighbor position
                float3 rgbCur  = src.SampleLevel(samp, uv2, 0.0).rgb;
                float3 rgbPrev = srcPrev.SampleLevel(samp, uv2, 0.0).rgb;
                
                // Blend them
                float3 rgbN = lerp(rgbCur, rgbPrev, temporalSmoothing);

                // Convert to Luma and accumulate
                float LN = dot(rgbN, float3(0.299, 0.587, 0.114));
                L_blur += LN * k[idx++] * (1.0 / 16.0);
            }
        }

        // Blend between sharp and blurred based on strength
        float L_processed = lerp(L, L_blur, blurStrength);

        // ------------------------------------------------------------
        // 3. High-Pass Filter (Lighting Invariance)
        // Fix: Use Fixed Mip 4 so background subtraction is consistent.
        // Fix: Smooth the background too, so shadows don't "shimmer".
        // ------------------------------------------------------------
        float3 wideCur  = src.SampleLevel(samp, uv, 4.0).rgb;
        float3 widePrev = srcPrev.SampleLevel(samp, uv, 4.0).rgb;
        float3 wideBlurRGB = lerp(wideCur, widePrev, temporalSmoothing);

        float L_wide = dot(wideBlurRGB, float3(0.299, 0.587, 0.114));
        
        // Subtract background, re-center at mid-grey (0.5)
        float L_highpass = (L_processed - L_wide) + 0.5;
        
        L_processed = lerp(L_processed, L_highpass, lightingInvariance);

        // ------------------------------------------------------------
        // 4. Linear Contrast Stretch
        // ------------------------------------------------------------
        float contrast = 1.0 + (contrastBoost * 4.0); 
        L_processed = (L_processed - 0.5) * contrast + 0.5;
        
        // Clamp to ensure valid 0..1 range
        L_processed = saturate(L_processed);

        // ------------------------------------------------------------
        // 5. Output
        // ------------------------------------------------------------
        outTex[pixel] = float4(L_processed, L_processed, L_processed, 1.0);
    }

    float ExpDecay(float dt, float halfLife)
    {
        // halfLife in frames if dt=1, or seconds if dt=seconds
        return exp2(-dt / max(halfLife, 1e-4));
    }

    float SoftThreshold(float x, float t, float k)
    {
        return saturate((x - t) / max(k, 1e-4));
    }

// Accumulation mode:
// 0 = crisp (max) -> sharp, clean trails
// 1 = inky  (add) -> smoother, more “smoke/ink” persistence
#define HISTORY_INKY 0

// Motion-history with FLOW ADVECTION + presence-diff injection
void UpdateMotionHistory_FromPresence_WithFlow(
    int2                 pixel,
    int2                 size,
    Texture2D<float4>    presenceCur,      // 0..1 in .r (or choose channel below)
    Texture2D<float4>    presencePrev,     // 0..1 in .r
    Texture2D<float4>    flowTex,          // flow in PIXELS per frame (or px/sec if dt matches)
    Texture2D<float4>    prevHistory,      // history in .r
    RWTexture2D<float4>  outHistory,
    SamplerState         samp,
    float                dt,               // 1.0 if per-frame, or seconds if flow is px/sec
    float                halfLife,         // decay half-life (frames or seconds)
    float                motionGain,       // scales injected motion energy
    float                diffThresh,       // threshold for |presenceCur - presencePrev|
    float                diffKnee,         // softness around threshold
    float                presenceGate,     // minimum presence (union) to allow injection
    float                flowScale,        // scale flow magnitude into ~0..1
    float                flowGateThresh,   // threshold for flow magnitude (0..1 domain)
    float                flowGateKnee      // softness for flow magnitude gate
)
{
    if (pixel.x < 0 || pixel.x >= size.x || pixel.y < 0 || pixel.y >= size.y)
        return;

    float2 invSize = 1.0 / float2(size);
    float2 uv      = (float2(pixel) + 0.5) * invSize;

    // ------------------------------------------------------------
    // 1) Read flow + backward-advect previous history
    // ------------------------------------------------------------
    float2 flowPx = flowTex.SampleLevel(samp, uv, 0).xy;

    // Backward trace (semi-Lagrangian). Clamp to avoid sampling border/0.
    float2 uvPrev = saturate(uv - (flowPx * dt) * invSize);

    float histPrev = prevHistory.SampleLevel(samp, uvPrev, 0).r;

    // ------------------------------------------------------------
    // 2) Decay (half-life based)
    // ------------------------------------------------------------
    float hist = histPrev * ExpDecay(dt, halfLife);

    // ------------------------------------------------------------
    // 3) Motion injection from presence difference
    // ------------------------------------------------------------
    float pC = presenceCur.SampleLevel(samp, uv, 0).r;
    float pP = presencePrev.SampleLevel(samp, uv, 0).r;

    // Appearance change energy
    float d = abs(pC - pP);

    // Soft threshold diff -> motion energy 0..1
    float m = SoftThreshold(d, diffThresh, diffKnee);

    // Gate injection by union presence (prevents background shimmer)
    float unionPresence = max(pC, pP);
    float gatePresence  = SoftThreshold(unionPresence, presenceGate, 0.10);
    m *= gatePresence;

    // Optional: gate by flow magnitude (helps suppress false diffs)
    // flowScale maps typical flow magnitudes to ~0..1 range.
    float flowMag01 = saturate(length(flowPx) * flowScale);
    float gateFlow  = SoftThreshold(flowMag01, flowGateThresh, flowGateKnee);

    // Blend in the flow gate moderately (0.0 ignore, 1.0 fully)
    m *= lerp(1.0, gateFlow, 0.5);

    // Gain after gating/thresholding
    m = saturate(m * motionGain);

    // ------------------------------------------------------------
    // 4) Accumulate into history
    // ------------------------------------------------------------
#if HISTORY_INKY
    // Inky: integrates energy while leaving headroom -> smooth trails
    hist = saturate(hist + m * (1.0 - hist));
#else
    // Crisp: “max” stamping -> sharp, stable trails
    hist = saturate(max(hist, m));
#endif

    outHistory[pixel] = float4(hist, hist, hist, 1.0);
}


    // ------------------------------------------------------------
    // Helper: per-pixel derivatives between two frames
    //
    //  pixel        : pixel coordinate (0..width-1, 0..height-1)
    //  levelSize    : int2(width, height)
    //  tex0, tex1   : frames (e.g. current & previous)
    //  samp         : sampler (linear or point, clamp)
    //  outDeriv.xyz : (Ix, Iy, It)
    // ------------------------------------------------------------
    void Derivatives_Pixel(
        int2                    pixel,
        int2                    levelSize,
        Texture2D<float4>       tex0,
        Texture2D<float4>       tex1,
        RWTexture2D<float4>     derivOut,
        SamplerState            samp)
    {
        float2 size  = float2(levelSize);
        float2 texel = 1.0 / size;
        float2 uv    = (float2(pixel) + 0.5) / size;

        // Luminance at this pixel in both frames
        float3 c0 = tex0.SampleLevel(samp, uv, 0.0).rgb;
        float3 c1 = tex1.SampleLevel(samp, uv, 0.0).rgb;

        float I0 = OpticalFlow_Luma(c0);
        float I1 = OpticalFlow_Luma(c1);

        // Spatial derivatives on tex0 (central difference)
        float Ix = (OpticalFlow_Luma(tex0.SampleLevel(samp, uv + float2(texel.x, 0), 0.0).rgb) -
                    OpticalFlow_Luma(tex0.SampleLevel(samp, uv - float2(texel.x, 0), 0.0).rgb)) * 0.5;

        float Iy = (OpticalFlow_Luma(tex0.SampleLevel(samp, uv + float2(0, texel.y), 0.0).rgb) -
                    OpticalFlow_Luma(tex0.SampleLevel(samp, uv - float2(0, texel.y), 0.0).rgb)) * 0.5;

        // Temporal derivative: brightness change
        float It = I0 - I1;

        derivOut[pixel] = float4(Ix, Iy, It, 1);
    }

    // ------------------------------------------------------------
    // CONFIG (you can tweak these)
    // ------------------------------------------------------------
    static const uint BLOCK_SIZE = 16;   // thread group size (x,y)
    static const uint RADIUS     = 1;    // neighborhood radius for HS (1 => 5-point)
    static const uint LOCAL_ITER = 4;    // HS iterations per dispatch

    // Shared tiles for HS solver (only used by HSGroup_Compute)
    groupshared float2 shFlowA[BLOCK_SIZE + 2 * RADIUS][BLOCK_SIZE + 2 * RADIUS];
    groupshared float2 shFlowB[BLOCK_SIZE + 2 * RADIUS][BLOCK_SIZE + 2 * RADIUS];
    groupshared float3 shDeriv[BLOCK_SIZE][BLOCK_SIZE]; // (Ix, Iy, It)

    // ------------------------------------------------------------
    // KERNEL 2: HSGroup compute (tiled Horn–Schunck with groupshared)
    //
    //  dtId          : SV_DispatchThreadID
    //  gtId          : SV_GroupThreadID
    //  levelSize     : int2(width, height)
    //  derivTex      : Texture2D<float4> (Ix, Iy, It, _)
    //  flowIn        : Texture2D<float2>  (u, v) initial flow
    //  flowOut       : RWTexture2D<float2> result flow
    //  linearSampler : sampler
    //  lambda        : smoothness parameter (0.01..0.5 typical)
    //  eps           : small epsilon (1e-3)
    //
    // [numthreads] MUST match BLOCK_SIZE, BLOCK_SIZE,1
    //
    // Dispatch:
    //   groupsX = ceil(width  / BLOCK_SIZE)
    //   groupsY = ceil(height / BLOCK_SIZE)
    // ------------------------------------------------------------
    void HornSchunk(
        int2                    pixel,         // DispatchThreadId.xy
        int2                    local,         // GroupThreadId.xy
        int2                    levelSize,     // (width, height)
        Texture2D<float4>       derivTex,      // (Ix, Iy, It, _)
        Texture2D<float4>       flowIn,        // current flow (u,v)
        RWTexture2D<float4>     flowOut,       // updated flow (u,v)
        SamplerState            linearSampler,
        float                   lambda,
        float                   eps)
    {
        // Is this pixel inside the valid image region?
        bool active = (pixel.x >= 0 && pixel.x < levelSize.x &&
                    pixel.y >= 0 && pixel.y < levelSize.y);

        // Clamp pixel for sampling so even out-of-bounds threads read valid data
        int2 pixelClamped = int2(
            clamp(pixel.x, 0, levelSize.x - 1),
            clamp(pixel.y, 0, levelSize.y - 1)
        );

        float2 size = float2(levelSize);
        float2 uv   = (float2(pixelClamped) + 0.5) / size;

        // Local shared index for this thread (with halo border)
        int2 sCenter = local + int2(RADIUS, RADIUS);

        // -------------------------------------------------------------------------
        // 1) Load derivatives & flow into shared memory
        // -------------------------------------------------------------------------
        float4 d = derivTex.SampleLevel(linearSampler, uv, 0.0);
        shDeriv[local.y][local.x] = d.xyz; // Ix, Iy, It

        float2 centerFlow = flowIn[pixelClamped].xy;

        // Initialize BOTH A and B with the same initial flow
        shFlowA[sCenter.y][sCenter.x] = centerFlow;
        shFlowB[sCenter.y][sCenter.x] = centerFlow;

        // -------------------------------------------------------------------------
        // 2) Load halo from global flow into BOTH shared buffers
        // -------------------------------------------------------------------------
        if (local.x == 0)
        {
            int2 pL = int2(max(pixelClamped.x - 1, 0), pixelClamped.y);
            float2 val = flowIn[pL].xy;
            shFlowA[sCenter.y][sCenter.x - 1] = val;
            shFlowB[sCenter.y][sCenter.x - 1] = val;
        }
        if (local.x == BLOCK_SIZE - 1)
        {
            int2 pR = int2(min(pixelClamped.x + 1, levelSize.x - 1), pixelClamped.y);
            float2 val = flowIn[pR].xy;
            shFlowA[sCenter.y][sCenter.x + 1] = val;
            shFlowB[sCenter.y][sCenter.x + 1] = val;
        }

        if (local.y == 0)
        {
            int2 pT = int2(pixelClamped.x, max(pixelClamped.y - 1, 0));
            float2 val = flowIn[pT].xy;
            shFlowA[sCenter.y - 1][sCenter.x] = val;
            shFlowB[sCenter.y - 1][sCenter.x] = val;
        }
        if (local.y == BLOCK_SIZE - 1)
        {
            int2 pB = int2(pixelClamped.x, min(pixelClamped.y + 1, levelSize.y - 1));
            float2 val = flowIn[pB].xy;
            shFlowA[sCenter.y + 1][sCenter.x] = val;
            shFlowB[sCenter.y + 1][sCenter.x] = val;
        }

        // (Optional) add 4 corner halo loads for 8-neighbour smoothing.

        GroupMemoryBarrierWithGroupSync();

        // -------------------------------------------------------------------------
        // 3) HS iterations in shared memory (Jacobi ping-pong A/B)
        // -------------------------------------------------------------------------
        bool useA = true; // true: read A → write B, false: read B → write A

        [loop]
        for (int iter = 0; iter < LOCAL_ITER; ++iter)
        {
            float3 deriv = shDeriv[local.y][local.x];
            float  Ix    = deriv.x;
            float  Iy    = deriv.y;
            float  It    = deriv.z;

            float2 Uav;
            if (useA)
            {
                float2 c = shFlowA[sCenter.y][sCenter.x];
                float2 l = shFlowA[sCenter.y][sCenter.x - 1];
                float2 r = shFlowA[sCenter.y][sCenter.x + 1];
                float2 t = shFlowA[sCenter.y - 1][sCenter.x];
                float2 b = shFlowA[sCenter.y + 1][sCenter.x];
                Uav = (c + l + r + t + b) / 5.0;
            }
            else
            {
                float2 c = shFlowB[sCenter.y][sCenter.x];
                float2 l = shFlowB[sCenter.y][sCenter.x - 1];
                float2 r = shFlowB[sCenter.y][sCenter.x + 1];
                float2 t = shFlowB[sCenter.y - 1][sCenter.x];
                float2 b = shFlowB[sCenter.y + 1][sCenter.x];
                Uav = (c + l + r + t + b) / 5.0;
            }

            float Ix2 = Ix * Ix;
            float Iy2 = Iy * Iy;
            float P   = Ix * Uav.x + Iy * Uav.y + It;
            float D   = lambda + Ix2 + Iy2 + eps;

            float2 uvNew;
            uvNew.x = Uav.x - Ix * (P / D);
            uvNew.y = Uav.y - Iy * (P / D);

            if (useA)
                shFlowB[sCenter.y][sCenter.x] = uvNew;
            else
                shFlowA[sCenter.y][sCenter.x] = uvNew;

            GroupMemoryBarrierWithGroupSync();
            useA = !useA;
        }

        // -------------------------------------------------------------------------
        // 4) Write back final flow (only for active pixels)
        // -------------------------------------------------------------------------
        float2 finalFlow =
            useA
            ? shFlowA[sCenter.y][sCenter.x]
            : shFlowB[sCenter.y][sCenter.x];

        if (active)
            flowOut[pixel] = float4(finalFlow,0.0,1.0);
    }

    // ------------------------------------------------------------
    // KERNEL 3: Warp compute
    //
    //  dtId          : SV_DispatchThreadID
    //  levelSize     : int2(width, height)
    //  src           : original frame
    //  flowTex       : flow field (u,v) in pixels
    //  warpedOut     : RWTexture2D<float4> warped result
    //  samp          : sampler
    //  flowToUvScale : float2(1/width, 1/height) or similar
    //
    // Dispatch:
    //   groupsX = ceil(width  / groupSizeX)
    //   groupsY = ceil(height / groupSizeY)
    // ------------------------------------------------------------
    void Warp(
        int2                    pixel,
        int2                    levelSize,
        Texture2D<float4>       src,
        Texture2D<float4>       flowTex,
        RWTexture2D<float4>     warpedOut,
        SamplerState            samp,
        float2                  flowToUvScale)
    {

        float2 size = float2(levelSize);
        float2 uv   = (float2(pixel) + 0.5) / size;

        float2 flow   = flowTex.SampleLevel(samp, uv, 0.0).xy;   // in pixels
        float2 uvWarp = uv + flow * flowToUvScale;          // convert to UV offset

        warpedOut[pixel] = src.SampleLevel(samp, uvWarp, 0.0);
    }

    // ------------------------------------------------------------
    // KERNEL 4: Upscale Flow (Bilinear + Mult 2.0)
    // Use this to go from Level N+1 to Level N
    // ------------------------------------------------------------
    void UpscaleFlow(
        int2                    pixel,
        int2                    levelSize,     // Target High-Res Size
        Texture2D<float4>       lowResFlow,    // Input Low-Res Flow
        RWTexture2D<float4>     highResFlow,   // Output High-Res Flow
        SamplerState            linearSampler)
    {
        float2 size = float2(levelSize);
        float2 uv   = (float2(pixel) + 0.5) / size;

        // Hardware Bilinear Interpolation
        float4 flow = lowResFlow.SampleLevel(linearSampler, uv, 0);

        // OPTICAL FLOW SCALING:
        // When you double the image resolution, the flow vectors (in pixels)
        // must also be doubled to point to the same relative location.
        highResFlow[pixel] = flow * 2.0; 
    }

    // ------------------------------------------------------------
    // KERNEL 5: Downscale Image (Simple Bilinear)
    // Use this if you don't want to use GenerateMips()
    // ------------------------------------------------------------
    void DownscaleImage(
        int2                    pixel,
        int2                    levelSize,     // Target Low-Res Size
        Texture2D<float4>       highResTex,    // Input High-Res
        RWTexture2D<float4>     lowResTex,     // Output Low-Res
        SamplerState            linearSampler)
    {
        float2 size = float2(levelSize);
        float2 uv   = (float2(pixel) + 0.5) / size;

        // Hardware Bilinear Interpolation
        lowResTex[pixel] = highResTex.SampleLevel(linearSampler, uv, 0);

        // 3. Filtered Downscaling (Gaussian-weighted 5-tap)
        // Eliminates temporal jitter/shimmering by blurring high-frequency noise.
        // Uses weights: Center(0.4) + 4xDiagonalNeighbors(0.15).
        float2 texel = 1.0 / size; 

        float4 acc = highResTex.SampleLevel(linearSampler, uv, 0) * 0.4;
        acc += highResTex.SampleLevel(linearSampler, uv + float2(-texel.x, -texel.y), 0) * 0.15;
        acc += highResTex.SampleLevel(linearSampler, uv + float2( texel.x, -texel.y), 0) * 0.15;
        acc += highResTex.SampleLevel(linearSampler, uv + float2(-texel.x,  texel.y), 0) * 0.15;
        acc += highResTex.SampleLevel(linearSampler, uv + float2( texel.x,  texel.y), 0) * 0.15;

        lowResTex[pixel] = acc;
    }

    // ------------------------------------------------------------
    // KERNEL 6: Advect a texture by the flow field
    //
    //  pixel         : DispatchThreadId.xy
    //  levelSize     : int2(width, height) of this level
    //  level         : mip level if using mipmapped textures (0 if not)
    //  advectedPrev  : previous advected texture (at same resolution)
    //  injectTex     : source of fresh color/noise (can be same as advectedPrev)
    //  flowTex       : flow field (u,v) in *pixels per frame*
    //  advectedOut   : RW output texture (same res as levelSize)
    //  samp          : linear + clamp sampler
    //  advectStrength: scale factor for how much of the flow to apply (1 = full)
    //  injectAmount  : how much new color to blend in [0..1]
    //
    //  Typical usage:
    //      - advectStrength ~ 1.0 for "full" advection
    //      - injectAmount   ~ 0.01..0.1 to slowly refresh pattern
    //
    //  Dispatch:
    //      groupsX = ceil(levelSize.x / groupSizeX)
    //      groupsY = ceil(levelSize.y / groupSizeY)
    // ------------------------------------------------------------
    void AdvectTexture(
        int2                    pixel,
        int2                    levelSize,
        Texture2D<float4>       advectedPrev,
        Texture2D<float4>       injectTex,
        Texture2D<float4>       flowTex,
        RWTexture2D<float4>     advectedOut,
        SamplerState            samp,
        float                   advectStrength,
        float                   injectAmount)
    {

        float2 size  = float2(levelSize);
        float2 uv    = (float2(pixel) + 0.5) / size;

        // Flow is assumed to be in *pixels per frame* at this level.
        // Convert to UV offset: pixels -> [0..1] domain.
        float2 flowPx = flowTex.SampleLevel(samp, uv, 0.0).xy;   // (u,v) in pixels
        float2 uvOld  = uv - flowPx * advectStrength / size;

        // Sample previous advected texture at back-traced position.
        // Sampler should be CLAMP to keep inside domain.
        float4 advectedColor = advectedPrev.SampleLevel(samp, uvOld, 0.0);

        // Optional: inject fresh pattern/noise at current position
        float4 injectColor   = injectTex.SampleLevel(samp, uv, 0.0);

        // Blend: mostly old advected color, plus a bit of new injection
        float4 outColor = lerp(advectedColor, injectColor, saturate(injectAmount));

        advectedOut[pixel] = outColor;
    }

    // ------------------------------------------------------------
    // KERNEL: AdvectTexture_Trails
    //
    // Purpose
    //   Advect a texture by flow and build persistent trails by applying
    //   explicit decay and additive injection.
    //
    // Differences vs "AdvectTexture"
    //   - Adds decay (old content fades over time)
    //   - Uses additive injection (keeps transported structure visible)
    //
    // Parameters
    //   decay           : 0..1 (typical 0.97..0.995 per frame)
    //   injectAmount    : strength of injection (can be small like 0.01..0.2)
    // ------------------------------------------------------------
    void AdvectTexture_Additive(
        int2                    pixel,
        int2                    levelSize,
        Texture2D<float4>       advectedPrev,
        Texture2D<float4>       injectTex,
        Texture2D<float4>       flowTex,
        RWTexture2D<float4>     advectedOut,
        SamplerState            samp,
        float                   advectStrength,
        float                   injectAmount,
        float                   decay)
    {
        // ------------------------------------------------------------
        // 0) Bounds Check
        // ------------------------------------------------------------
        if (pixel.x < 0 || pixel.x >= levelSize.x ||
            pixel.y < 0 || pixel.y >= levelSize.y)
            return;

        // ------------------------------------------------------------
        // 1) UV Coordinates
        // ------------------------------------------------------------
        float2 size = float2(levelSize);
        float2 uv   = (float2(pixel) + 0.5) / size;

        // ------------------------------------------------------------
        // 2) Backward Trace using Flow (pixels/frame -> UV)
        // ------------------------------------------------------------
        float2 flowPx = flowTex.SampleLevel(samp, uv, 0.0).xy;
        float2 uvOld  = uv - (flowPx * advectStrength) / size;
        uvOld = saturate(uvOld);

        // ------------------------------------------------------------
        // 3) Sample Previous Field at Back-Traced Position (Advect)
        // ------------------------------------------------------------
        float4 advectedVal = advectedPrev.SampleLevel(samp, uvOld, 0.0);

        // ------------------------------------------------------------
        // 4) Apply Decay (fades trails)
        // ------------------------------------------------------------
        // decay close to 1.0 keeps trails longer
        // decay smaller fades faster
        float d = saturate(decay);
        float4 baseVal = advectedVal * d;

        // ------------------------------------------------------------
        // 5) Inject Fresh Content (Additive)
        // ------------------------------------------------------------
        float4 injectVal = injectTex.SampleLevel(samp, uv, 0.0);

        // Additive injection preserves advected structure rather than overwriting it.
        float a = saturate(injectAmount);
        float4 outVal = baseVal + injectVal * a;

        // Optional clamp if you want to keep values in [0..1]
        // outVal = saturate(outVal);

        // ------------------------------------------------------------
        // 6) Output
        // ------------------------------------------------------------
        advectedOut[pixel] = outVal;
    }

    // ------------------------------------------------------------
    // KERNEL: DiffuseHistory3x3
    //
    // Purpose
    //   Apply a small 3x3 Gaussian-ish diffusion to a scalar history field
    //   stored in tex.r, and write the result to an RWTexture.
    //
    // Inputs
    //   pixel     : DispatchThreadId.xy
    //   levelSize : resolution of this level
    //   srcTex    : history/source texture (expects scalar in .r)
    //   samp      : linear + clamp sampler
    //
    // Output
    //   outTex    : diffused history (written as float4)
    //
    // Params
    //   strength  : 0..1  (0 = no blur, 1 = full 3x3 blur)
    // ------------------------------------------------------------
    void Diffuse3x3(
        int2                pixel,
        int2                levelSize,
        Texture2D<float4>   srcTex,
        RWTexture2D<float4> outTex,
        SamplerState        samp,
        float               strength)
    {
        // 0) Bounds Check
        if (pixel.x < 0 || pixel.x >= levelSize.x ||
            pixel.y < 0 || pixel.y >= levelSize.y)
            return;

        // 1) UV setup
        float2 size    = float2(levelSize);
        float2 invSize = 1.0 / size;
        float2 uv      = (float2(pixel) + 0.5) * invSize;
        float2 t       = invSize;

        // 2) Center sample (scalar in .r)
        float c = srcTex.SampleLevel(samp, uv, 0).r;

        // 3) 3x3 Gaussian-ish kernel
        float s = 0.0;

        s += srcTex.SampleLevel(samp, uv + float2(-t.x, -t.y), 0).r * 1.0;
        s += srcTex.SampleLevel(samp, uv + float2( 0.0, -t.y), 0).r * 2.0;
        s += srcTex.SampleLevel(samp, uv + float2( t.x, -t.y), 0).r * 1.0;

        s += srcTex.SampleLevel(samp, uv + float2(-t.x,  0.0), 0).r * 2.0;
        s += c                                                   * 4.0;
        s += srcTex.SampleLevel(samp, uv + float2( t.x,  0.0), 0).r * 2.0;

        s += srcTex.SampleLevel(samp, uv + float2(-t.x,  t.y), 0).r * 1.0;
        s += srcTex.SampleLevel(samp, uv + float2( 0.0,  t.y), 0).r * 2.0;
        s += srcTex.SampleLevel(samp, uv + float2( t.x,  t.y), 0).r * 1.0;

        float blur = s * (1.0 / 16.0);

        // 4) Blend between original and blurred based on strength
        float a = saturate(strength);
        float outV = lerp(c, blur, a);

        // 5) Output (store scalar in RGB, alpha = 1)
        outTex[pixel] = float4(outV, outV, outV, 1.0);
    }

    // ------------------------------------------------------------
    // KERNEL: DiffuseHistoryCross
    //
    // Purpose
    //   Apply a 5-tap cross diffusion (cheaper than 3x3).
    //
    // Params
    //   strength : 0..1  (0 = none, 1 = full cross blur)
    // ------------------------------------------------------------
    void DiffuseCross(
        int2                pixel,
        int2                levelSize,
        Texture2D<float4>   srcTex,
        RWTexture2D<float4> outTex,
        SamplerState        samp,
        float               strength)
    {
        if (pixel.x < 0 || pixel.x >= levelSize.x ||
            pixel.y < 0 || pixel.y >= levelSize.y)
            return;

        float2 size    = float2(levelSize);
        float2 invSize = 1.0 / size;
        float2 uv      = (float2(pixel) + 0.5) * invSize;
        float2 t       = invSize;

        float c = srcTex.SampleLevel(samp, uv, 0).r;
        float u = srcTex.SampleLevel(samp, uv + float2(0, -t.y), 0).r;
        float d = srcTex.SampleLevel(samp, uv + float2(0,  t.y), 0).r;
        float l = srcTex.SampleLevel(samp, uv + float2(-t.x, 0), 0).r;
        float r = srcTex.SampleLevel(samp, uv + float2( t.x, 0), 0).r;

        float blur = (c * 4.0 + u + d + l + r) * (1.0 / 8.0);

        float a = saturate(strength);
        float outV = lerp(c, blur, a);

        outTex[pixel] = float4(outV, outV, outV, 1.0);
    }



};
