shader FuseCommonOctreeCullingBoxGrid : FuseRenderingBoxGridProject,FuseCommonOctreeCulling{

    // BoxGrid-specific debug bits
    static const int DBG_BG_ROOM_AABB_FAIL   = 1 << 16;  // early-out in room AABB test
    static const int DBG_BG_CORNER_TESTED    = 1 << 17;  // at least one corner processed
    static const int DBG_BG_ANY_CORNER_HIT   = 1 << 18;  // some corner projected to a face
    static const int DBG_BG_ALL_CORNERS_FAIL = 1 << 19;  // BoxGridNodeVisibility returned outside
    static const int DBG_BG_USED_IN_PASS1    = 1 << 20;
    static const int DBG_BG_USED_IN_PASS2    = 1 << 21;

    bool RectsOverlap(float2 rMin, float2 rMax, float2 gMin, float2 gMax)
    {
        return (rMin.x <= gMax.x && rMax.x >= gMin.x) &&
           (rMin.y <= gMax.y && rMax.y >= gMin.y);
    }
    

    // Fixed-viewer corner test, kept for the BoxGridNodeIsVisible node; the cull passes use BoxGridNodeVisibility.
    // Returns true if ANY corner of the node's AABB projects onto the boxgrid
    // (i.e. ray from viewer → corner hits one of the 6 faces AND inside zoomRegion / faceLayout).
    // Returns: 0 = outside, 1 = intersecting, 2 = fully inside
    uint BoxGridNodeIsVisible(
        float3 boundsMin,
        float3 boundsMax,
        float4x4 ParticleToBoxGrid,
        float3 roomCenter,
        float3 roomDimensions,
        float4 zoomRegion,
        float3 viewerPosition,
        StructuredBuffer<float4> faceLayoutInfo,
        float4 crossLayoutInfo
    ){
        // Initialize inverted Min/Max
        float2 minUV = float2(1e20, 1e20);
        float2 maxUV = float2(-1e20, -1e20);

        // Test all 8 corners like your CPU CullBoundingBox
        [unroll]
        for (int i = 0; i < 8; ++i)
        {
            float3 cornerWS = float3(
                (i & 1) != 0 ? boundsMax.x : boundsMin.x,
                (i & 2) != 0 ? boundsMax.y : boundsMin.y,
                (i & 4) != 0 ? boundsMax.z : boundsMin.z
            );

            float3 tempHitPoint;
            int tempFaceIndex;
            float2 tempFaceUV01;
            float2 normalizedUV; 

            // Use RAW projection to get the true, unclamped UV coordinates
            projectParticleRaw(
                cornerWS,
                ParticleToBoxGrid,
                roomCenter,
                roomDimensions,
                zoomRegion,
                viewerPosition,
                tempHitPoint,
                tempFaceIndex,
                tempFaceUV01,
                normalizedUV,
                faceLayoutInfo,
                crossLayoutInfo
            );

            minUV = min(minUV, normalizedUV);
            maxUV = max(maxUV, normalizedUV);            
        }

        if (!RectsOverlap(minUV,maxUV,float2(0.0,0.0),float2(1.0,1.0)))
            return 0; // outside

        // Fully inside if all corners project within [0,1]
        if (minUV.x >= 0.0 && minUV.y >= 0.0 && maxUV.x <= 1.0 && maxUV.y <= 1.0)
            return 2; // fully inside

        return 1; // intersecting
    }

    // --------------------------------------------------------------------------------------
    // Node atlas UVs
    // --------------------------------------------------------------------------------------
    // Culling does not project here. A separate pass (OctreePlyCullBoxGrid, "Project Node Points")
    // projects 17 points of every node with ProjectPosition (360 To BoxGrid), the same node the particles
    // use, including their View Warp. It writes one float3 per point:
    // xy = UV in the crop (0..1 inside, also written outside), z = face index the ray leaves the room
    // through (0 floor .. 5, -1 = none). It projects with a huge UV margin so the face is kept outside the crop.
    // Layout per node (NODE_POINT_COUNT entries from nodeID * NODE_POINT_COUNT):
    //   0      centre
    //   1..8   corners of the node (BoundsMin..BoundsMax): its size, for the LOD
    //   9..16  corners of the widened node (BoundsMin - expandMin .. BoundsMax + expandMax): its reach, for the
    //          in/out test (the consumer moves points by up to that much after the cull)
    // Without expansion both corner sets are the same and the result is that of the plain node.

    static const int NODE_POINT_COUNT = 17;
    static const int NODE_CORNERS = 1;
    static const int NODE_REACH_CORNERS = 9;

    float3 OctreeNodeCorner(float3 bmin, float3 bmax, int i)
    {
        return float3(
            (i & 1) != 0 ? bmax.x : bmin.x,
            (i & 2) != 0 ? bmax.y : bmin.y,
            (i & 4) != 0 ? bmax.z : bmin.z);
    }

    // Point k of a node in octree space (layout above), for the projection pass.
    float3 OctreeNodePoint(StructuredBuffer<GPUOctreeNode> GpuOctreeNodes, int pointIndex, float3 expandMin, float3 expandMax)
    {
        GPUOctreeNode node = GpuOctreeNodes[pointIndex / NODE_POINT_COUNT];
        int k = pointIndex % NODE_POINT_COUNT;
        if (k == 0)
            return (node.BoundsMin + node.BoundsMax) * 0.5f;
        if (k < NODE_REACH_CORNERS)
            return OctreeNodeCorner(node.BoundsMin, node.BoundsMax, k - NODE_CORNERS);
        return OctreeNodeCorner(node.BoundsMin - max(expandMin, 0.0f), node.BoundsMax + max(expandMax, 0.0f), k - NODE_REACH_CORNERS);
    }

    // UV rectangle of the centre and 8 corners starting at `first`; false when they leave through different faces.
    bool NodeRect(int nodeID, RWStructuredBuffer<float3> NodeUVs, int first, out float2 minUV, out float2 maxUV)
    {
        float3 c = NodeUVs[nodeID * NODE_POINT_COUNT];
        int face = (int)round(c.z);
        bool oneFace = face >= 0;
        minUV = c.xy;
        maxUV = c.xy;
        [unroll]
        for (int i = 0; i < 8; ++i)
        {
            float3 p = NodeUVs[nodeID * NODE_POINT_COUNT + first + i];
            oneFace = oneFace && ((int)round(p.z) == face);
            minUV = min(minUV, p.xy);
            maxUV = max(maxUV, p.xy);
        }
        return oneFace;
    }

    // Visibility of a node in the crop from its projected points.
    // Returns 0 = outside, 1 = intersecting, 2 = fully inside.
    // screenSize: larger side of the node's UV rectangle in crop pixels (uv extent * viewportHeight), the same unit
    // as ApproxScreenSpaceSize in the frustum path; from the node itself, so the expansion does not change the LOD.
    //
    // NodeUVs z holds the face the ray from the viewer leaves the room through (0..5, -1 = no face),
    // xy the crop UV of that hit, also outside 0..1 (ProjectOctreeNodePoints projects with a UV margin
    // so large that the face index is never cleared).
    // All nine points of a box on one face: for a fixed viewer every ray to the box leaves through that face (the box
    // lies in the convex pyramid viewer -> face) and the map to the crop is a perspective projection followed by an
    // affine one, so the box's image is the convex hull of its corner UVs. If the rectangle of the widened box misses
    // the crop, the node is outside and dropped (e.g. nodes towards the ceiling or the open end of the room).
    // Points on different faces: the box spans a room edge, the atlas is not continuous there, so the node is kept
    // and always refined; its children end up on one face.
    // A View Warp that moves the viewer per point breaks the hull argument a little (Forest Reference: walls
    // <= 0.03 m, floor <= 0.36 m, ceiling more; work/fps_drift/cullcheck.py); the expansion covers that too.
    // Until 2026-11 z was the face index read as a hit flag: floor hits (0) and every point outside the
    // crop counted as "no hit", such nodes were kept at full size, and over budget they thinned the
    // whole visible cloud.
    uint BoxGridNodeVisibility(
        int nodeID,
        RWStructuredBuffer<float3> NodeUVs,
        float uvMargin,
        float viewportHeight,
        out float screenSize)
    {
        float2 minUV, maxUV;
        bool oneFace = NodeRect(nodeID, NodeUVs, NODE_CORNERS, minUV, maxUV);
        float2 extent = maxUV - minUV;
        screenSize = oneFace ? max(extent.x, extent.y) * viewportHeight : viewportHeight;

        if (!NodeRect(nodeID, NodeUVs, NODE_REACH_CORNERS, minUV, maxUV))
            return 1;

        if (!RectsOverlap(minUV, maxUV, float2(-uvMargin, -uvMargin), float2(1.0f + uvMargin, 1.0f + uvMargin)))
            return 0;

        bool allInside = minUV.x >= 0.0f && minUV.y >= 0.0f && maxUV.x <= 1.0f && maxUV.y <= 1.0f;
        return allInside ? 2 : 1;
    }


    // Debug: projects centre and corners with one fixed viewer into NodeDraw (Output 3 of OctreePlyCullBoxGrid).
    void projectNode(
        int nodeID,
        float4x4 ParticleToBoxGrid,
        float3 roomCenter,
        float3 roomDimensions,
        float4 zoomRegion,
        float3 viewerPosition,
        StructuredBuffer<GPUOctreeNode> GpuOctreeNodes,
        StructuredBuffer<float4> faceLayoutInfo,
        float4 crossLayoutInfo,
        RWStructuredBuffer<float3> NodeDraw
    ){
        float3 hitPoint;
        int   faceIndex;
        float2 faceUV01;
        float2 UV;
        GPUOctreeNode node = GpuOctreeNodes[nodeID];

        NodeDraw[nodeID *9] = projectParticleByViewPositionAABB(
                (node.BoundsMax + node.BoundsMin) / 2.0,
                ParticleToBoxGrid,
                roomCenter,
                roomDimensions,
                zoomRegion,
                viewerPosition,
                hitPoint,
                faceIndex,
                faceUV01,
                UV,
                faceLayoutInfo,
                crossLayoutInfo,
                0.0f
            );
            //NodeDraw[nodeID *9] = float3(UV,0.0);

        [unroll]
        for (int i = 0; i < 8; ++i)
        {
            float3 cornerWS = float3(
                (i & 1) != 0 ? node.BoundsMax.x : node.BoundsMin.x,
                (i & 2) != 0 ? node.BoundsMax.y : node.BoundsMin.y,
                (i & 4) != 0 ? node.BoundsMax.z : node.BoundsMin.z
            );

            NodeDraw[nodeID *9 + 1 + i] = projectParticleByViewPositionAABB(
                cornerWS,
                ParticleToBoxGrid,
                roomCenter,
                roomDimensions,
                zoomRegion,
                viewerPosition,
                hitPoint,
                faceIndex,
                faceUV01,
                UV,
                faceLayoutInfo,
                crossLayoutInfo,
                0.0f
            );
            //NodeDraw[nodeID *9 + 1 + i] = float3(UV,0.0);



            

            
        }
    }


    // PASS 1: Generate work items from the node atlas UVs.
    // Runs in a single thread, so it only distributes the visible subtrees at MinWorkItemDepth (at most 8^depth
    // work items) and leaves LOD selection to the parallel pass 2, which applies the same visibility and LOD rules.
    // It used to keep descending while a node was larger than 2 * LODScreenSpaceThreshold, down to
    // MinWorkItemDepth + 3. With the BoxGrid screen size (UV extent * viewport height, 7138eaa7) almost every node is
    // "large" and few are outside, so that single thread visited nearly the whole tree to depth 6:
    // ~17 ms per run in ForestReferenceScene (Forest/Occtree BoxGrid/Generate Work Items), now ~0.2 ms.
    void GenerateWorkItems_BoxGrid(
        RWStructuredBuffer<float3> NodeUVs,
        float  uvMargin,
        float  viewportHeight,
        float  LODScreenSpaceThreshold, // pixels in the crop
        int    MinWorkItemDepth,
        int    startID,
        StructuredBuffer<GPUOctreeNode> GpuOctreeNodes,
        RWStructuredBuffer<int> WorkItems,
        RWStructuredBuffer<int> WorkItemCounter,
        RWStructuredBuffer<int> NodeDebugFlags
    ){
        // Depth-first down to MinWorkItemDepth needs at most 7 * depth + 1 entries (128 covers depth 18).
        int nodeStack[128];
        int insideStack[128];
        int stackTop = 0;

        if (startID >= 0)
        {
            nodeStack[stackTop] = startID;
            insideStack[stackTop] = 0;
            stackTop++;
        }

        while (stackTop > 0 && stackTop < 128)
        {
            --stackTop;
            int nodeID = nodeStack[stackTop];
            int parentFullyInside = insideStack[stackTop];
            GPUOctreeNode node = GpuOctreeNodes[nodeID];

            if (!IsValidNode(node))
                continue;

            float screenSize;
            uint bgVisibility = BoxGridNodeVisibility(nodeID, NodeUVs, uvMargin, viewportHeight, screenSize);
            if (parentFullyInside != 0)
                bgVisibility = 2;
            else if (bgVisibility == 0)
                continue;

            // Leaf node => always create work item if it has points
            if (node.ChildStartIndex == 0xFFFFFFFF || node.ChildStartIndex == -1)
            {
                if (node.IndexCount > 0)
                {
                    uint writeIndex;
                    InterlockedAdd(WorkItemCounter[0], 1, writeIndex);
                    WorkItems[writeIndex] = nodeID;
                }
                continue;
            }

            int childInside = (bgVisibility == 2) ? 1 : 0;

            if ((int)node.LODLevel < MinWorkItemDepth)
            {
                for (uint i = 0; i < 8; ++i)
                {
                    if (stackTop < 127)
                    {
                        nodeStack[stackTop] = node.ChildStartIndex + i;
                        insideStack[stackTop] = childInside;
                        stackTop++;
                    }
                }
            }
            else
            {
                uint writeIndex;
                InterlockedAdd(WorkItemCounter[0], 1, writeIndex);
                WorkItems[writeIndex] = nodeID;
            }
        }
    }

    // PASS 2: Process work items and select LOD from the node atlas UVs.
    // Same rules as ProcessWorkItem_AndSelectLOD in FuseCommonOctreeCulling.
    void ProcessWorkItem_AndSelectLOD_BoxGrid(
        int  globalThreadID,
        RWStructuredBuffer<float3> NodeUVs,
        float  uvMargin,
        float  viewportHeight,
        float  LODScreenSpaceThreshold, // pixels in the crop
        RWStructuredBuffer<int> WorkItems,
        RWStructuredBuffer<int> WorkItemCounter,
        StructuredBuffer<GPUOctreeNode> GpuOctreeNodes,
        RWStructuredBuffer<int> VisibleNodeIDs,
        RWStructuredBuffer<int> VisibleNodeCounter,
        RWStructuredBuffer<int> TotalPointCounter,
        RWStructuredBuffer<int> NodeDebugFlags)
    {
        int numWorkItems = WorkItemCounter[0];
        if (globalThreadID >= numWorkItems) return;

        int workNodeID = WorkItems[globalThreadID];

        int nodeStack[512];
        int insideStack[512];
        int stackTop = 0;
        nodeStack[stackTop] = workNodeID;
        insideStack[stackTop] = 0;
        stackTop++;

        while (stackTop > 0 && stackTop < 512)
        {
            --stackTop;
            int nodeID = nodeStack[stackTop];
            int parentFullyInside = insideStack[stackTop];
            GPUOctreeNode node = GpuOctreeNodes[nodeID];

            if (!IsValidNode(node))
                continue;

            float screenSize;
            uint bgVisibility = BoxGridNodeVisibility(nodeID, NodeUVs, uvMargin, viewportHeight, screenSize);
            if (parentFullyInside != 0)
                bgVisibility = 2;
            else if (bgVisibility == 0)
                continue;

            // too small for this LOD: discard
            if (screenSize < LODScreenSpaceThreshold * 0.5f)
                continue;

            bool isLeaf = (node.ChildStartIndex == 0xFFFFFFFF || node.ChildStartIndex == -1);

            if (isLeaf)
            {
                if (node.IndexCount > 0)
                {
                    uint writeIndex;
                    InterlockedAdd(VisibleNodeCounter[0], 1, writeIndex);
                    InterlockedAdd(TotalPointCounter[0], node.IndexCount);
                    VisibleNodeIDs[writeIndex] = nodeID;
                }
            }
            else
            {
                if (screenSize > LODScreenSpaceThreshold * 2.0f)
                {
                    // go deeper
                    int childInside = (bgVisibility == 2) ? 1 : 0;
                    for (int i = 0; i < 8; ++i)
                    {
                        if (stackTop < 511)
                        {
                            nodeStack[stackTop] = node.ChildStartIndex + i;
                            insideStack[stackTop] = childInside;
                            stackTop++;
                        }
                    }
                }
                else
                {
                    // render at this LOD: collect leaf descendants
                    int lodStack[256];
                    int lodTop = 0;
                    lodStack[lodTop++] = nodeID;

                    while (lodTop > 0 && lodTop < 256)
                    {
                        int lodNodeID = lodStack[--lodTop];
                        GPUOctreeNode lodNode = GpuOctreeNodes[lodNodeID];

                        bool lodIsLeaf = (lodNode.ChildStartIndex == 0xFFFFFFFF || lodNode.ChildStartIndex == -1);

                        if (lodIsLeaf)
                        {
                            if (lodNode.IndexCount > 0)
                            {
                                uint writeIndex;
                                InterlockedAdd(VisibleNodeCounter[0], 1, writeIndex);
                                InterlockedAdd(TotalPointCounter[0], lodNode.IndexCount);
                                VisibleNodeIDs[writeIndex] = lodNodeID;
                            }
                        }
                        else
                        {
                            for (int j = 0; j < 8; ++j)
                            {
                                if (lodTop < 255)
                                    lodStack[lodTop++] = lodNode.ChildStartIndex + j;
                            }
                        }
                    }
                }
            }
        }
    }

};
