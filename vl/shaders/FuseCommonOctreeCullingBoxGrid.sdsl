shader FuseCommonOctreeCullingBoxGrid : FuseRenderingBoxGridProject,FuseCommonOctreeCulling{

    // BoxGrid-specific debug bits
    static const int DBG_BG_ROOM_AABB_FAIL   = 1 << 16;  // early-out in room AABB test
    static const int DBG_BG_CORNER_TESTED    = 1 << 17;  // at least one corner processed
    static const int DBG_BG_ANY_CORNER_HIT   = 1 << 18;  // some corner projected to a face
    static const int DBG_BG_ALL_CORNERS_FAIL = 1 << 19;  // BoxGridNodeIsVisible returned false
    static const int DBG_BG_USED_IN_PASS1    = 1 << 20;
    static const int DBG_BG_USED_IN_PASS2    = 1 << 21;

    bool RectsOverlap(float2 rMin, float2 rMax, float2 gMin, float2 gMax)
    {
        return (rMin.x <= gMax.x && rMax.x >= gMin.x) &&
           (rMin.y <= gMax.y && rMax.y >= gMin.y);
    }
    
    
    // Returns true if ANY corner of the node's AABB projects onto the boxgrid
    // (i.e. ray from viewer → corner hits one of the 6 faces AND inside zoomRegion / faceLayout).
    bool BoxGridNodeIsVisible(
        float3 boundsMin,
        float3 boundsMax,
        float4x4 ParticleToBoxGrid,
        float3 roomCenter,
        float3 roomDimensions,
        float4 zoomRegion,
        float3 viewerPosition,
        StructuredBuffer<float4> faceLayoutInfo,
        float4 crossLayoutInfo
    ){
        // Initialize inverted Min/Max
        float2 minUV = float2(1e20, 1e20);
        float2 maxUV = float2(-1e20, -1e20);

        // Test all 8 corners like your CPU CullBoundingBox
        [unroll]
        for (int i = 0; i < 8; ++i)
        {
            float3 cornerWS = float3(
                (i & 1) != 0 ? boundsMax.x : boundsMin.x,
                (i & 2) != 0 ? boundsMax.y : boundsMin.y,
                (i & 4) != 0 ? boundsMax.z : boundsMin.z
            );

            int tempFaceIndex;
            float2 tempFaceUV01;
            float2 normalizedUV; 

            // Use RAW projection to get the true, unclamped UV coordinates
            projectParticleRaw(
                cornerWS,
                ParticleToBoxGrid,
                roomCenter,
                roomDimensions,
                zoomRegion,
                viewerPosition,
                tempFaceIndex,
                tempFaceUV01,
                normalizedUV,
                faceLayoutInfo,
                crossLayoutInfo
            );

            minUV = min(minUV, normalizedUV);
            maxUV = max(maxUV, normalizedUV);            
        }

        return RectsOverlap(minUV,maxUV,float2(0.0,0.0),float2(1.0,1.0));
    }

    void projectNode(
        int nodeID,
        float4x4 ParticleToBoxGrid,
        float3 roomCenter,
        float3 roomDimensions,
        float4 zoomRegion,
        float3 viewerPosition,
        StructuredBuffer<GPUOctreeNode> GpuOctreeNodes,
        StructuredBuffer<float4> faceLayoutInfo,
        float4 crossLayoutInfo,
        RWStructuredBuffer<float3> NodeDraw
    ){
        int   faceIndex;
        float2 faceUV01;
        float2 UV;
        GPUOctreeNode node = GpuOctreeNodes[nodeID];

        NodeDraw[nodeID *9] = projectParticleByViewPositionAABB(
                (node.BoundsMax + node.BoundsMin) / 2.0,
                ParticleToBoxGrid,
                roomCenter,
                roomDimensions,
                zoomRegion,
                viewerPosition,
                faceIndex,
                faceUV01,
                UV,
                faceLayoutInfo,
                crossLayoutInfo
            );
            //NodeDraw[nodeID *9] = float3(UV,0.0);

        [unroll]
        for (int i = 0; i < 8; ++i)
        {
            float3 cornerWS = float3(
                (i & 1) != 0 ? node.BoundsMax.x : node.BoundsMin.x,
                (i & 2) != 0 ? node.BoundsMax.y : node.BoundsMin.y,
                (i & 4) != 0 ? node.BoundsMax.z : node.BoundsMin.z
            );

            NodeDraw[nodeID *9 + 1 + i] = projectParticleByViewPositionAABB(
                cornerWS,
                ParticleToBoxGrid,
                roomCenter,
                roomDimensions,
                zoomRegion,
                viewerPosition,
                faceIndex,
                faceUV01,
                UV,
                faceLayoutInfo,
                crossLayoutInfo
            );
            //NodeDraw[nodeID *9 + 1 + i] = float3(UV,0.0);



            

            
        }
    }


    // Simple LOD metric: approximate "screen size" by boundsSize / distance.
    // You can tune LODScale to match your setup.
    float ComputeBoxGridScreenSize(
        float3 boundsMin,
        float3 boundsMax,
        float3 viewerPosition,
        float LODScale)
    {
        float3 center = 0.5f * (boundsMin + boundsMax);
        float  size   = max(max(boundsMax.x - boundsMin.x,
                                boundsMax.y - boundsMin.y),
                                boundsMax.z - boundsMin.z);

        float  dist   = distance(center, viewerPosition);
        dist = max(dist, 0.0001f);

        return (size / dist) * LODScale;
    }

    // PASS 1: Generate work items using ONLY BoxGrid culling
    void GenerateWorkItems_BoxGrid(
        float3 viewerPosition,
        float3 roomCenter,
        float3 roomDimensions,
        float4x4 ParticleToBoxGrid,
        float4 zoomRegion,
        float  LODScreenSpaceThreshold, // interpreted with ComputeBoxGridScreenSize
        float  LODScale,                // tweakable scale factor
        int    MinWorkItemDepth,
        int    startID,
        StructuredBuffer<GPUOctreeNode> GpuOctreeNodes,
        StructuredBuffer<float4> FaceLayoutInfo,
        float4 crossLayoutInfo,
        RWStructuredBuffer<int> WorkItems,
        RWStructuredBuffer<int> WorkItemCounter,
        RWStructuredBuffer<int> NodeDebugFlags
    ){
        int nodeStack[1024];
        int stackTop = 0;

        if (startID >= 0)
            nodeStack[stackTop++] = startID;

        while (stackTop > 0 && stackTop < 1024)
        {
            int nodeID = nodeStack[--stackTop];
            GPUOctreeNode node = GpuOctreeNodes[nodeID];

            InterlockedOr(NodeDebugFlags[nodeID], DBG_TOUCHED_PASS1);
            
            // FIXED: Validate node first
            if (!IsValidNode(node))
            {
                InterlockedOr(NodeDebugFlags[nodeID], DBG_INVALID_NODE);
                continue;
            }
            InterlockedOr(NodeDebugFlags[nodeID], DBG_BG_USED_IN_PASS1);

            // --- NEW: BoxGrid visibility test
            if (!BoxGridNodeIsVisible(
                    node.BoundsMin,
                    node.BoundsMax,
                    ParticleToBoxGrid,
                    roomCenter,
                    roomDimensions,
                    zoomRegion,
                    viewerPosition,
                    FaceLayoutInfo,
                    crossLayoutInfo))
            {
                // node is completely invisible in the boxgrid
                InterlockedOr(NodeDebugFlags[nodeID], DBG_FRUSTUM_OUTSIDE);
                continue;
            }
                InterlockedOr(NodeDebugFlags[nodeID], DBG_FRUSTUM_INSIDE);

            // Leaf node => always create work item if it has points
            if (node.ChildStartIndex == 0xFFFFFFFF || node.ChildStartIndex == -1)
            {
                if (node.IndexCount > 0)
                {
                    uint writeIndex;
                    InterlockedAdd(WorkItemCounter[0], 1, writeIndex);
                    WorkItems[writeIndex] = nodeID;
                }
                continue;
            }

            // --- LOD decision based on viewer distance & node size
            float screenSize = ComputeBoxGridScreenSize(
                node.BoundsMin,
                node.BoundsMax,
                viewerPosition,
                LODScale
            );

            bool shouldTraverseDeeper =
                (screenSize > LODScreenSpaceThreshold * 2.0f) &&
                (node.LODLevel < MinWorkItemDepth + 3);

            bool canCreateWorkItem =
                (node.LODLevel >= MinWorkItemDepth) &&
                (screenSize <= LODScreenSpaceThreshold * 4.0f);

            if (shouldTraverseDeeper)
            {
                // traverse children
                for (uint i = 0; i < 8; ++i)
                {
                    if (stackTop < 1023)
                        nodeStack[stackTop++] = node.ChildStartIndex + i;
                }
            }
            else if (canCreateWorkItem)
            {
                uint writeIndex;
                InterlockedAdd(WorkItemCounter[0], 1, writeIndex);
                WorkItems[writeIndex] = nodeID;
            }
            else
            {
                // fallback: traverse children
                for (uint i = 0; i < 8; ++i)
                {
                    if (stackTop < 1023)
                        nodeStack[stackTop++] = node.ChildStartIndex + i;
                }
            }
        }
    }


    void ProcessWorkItem_AndSelectLOD_BoxGrid(
        int  globalThreadID,
        float3 viewerPosition,
        float3 roomCenter,
        float3 roomDimensions,
        float4x4 ParticleToBoxGrid,
        float4 zoomRegion,
        float  LODScreenSpaceThreshold,
        float  LODScale,
        RWStructuredBuffer<int> WorkItems,
        RWStructuredBuffer<int> WorkItemCounter,
        StructuredBuffer<GPUOctreeNode> GpuOctreeNodes,
        StructuredBuffer<float4> FaceLayoutInfo,
        float4 crossLayoutInfo,
        RWStructuredBuffer<int> VisibleNodeIDs,
        RWStructuredBuffer<int> VisibleNodeCounter,
        RWStructuredBuffer<int> TotalPointCounter,
        RWStructuredBuffer<int> NodeDebugFlags)
    {
        int numWorkItems = WorkItemCounter[0];
        if (globalThreadID >= numWorkItems) return;

        int workNodeID = WorkItems[globalThreadID];

        int nodeStack[512];
        int stackTop = 0;
        nodeStack[stackTop++] = workNodeID;

        while (stackTop > 0 && stackTop < 512)
        {
            int nodeID = nodeStack[--stackTop];
            GPUOctreeNode node = GpuOctreeNodes[nodeID];

            // Mark that this node was processed in Pass 2
            InterlockedOr(NodeDebugFlags[nodeID], DBG_TOUCHED_PASS2);

            // Validate node
            if (!IsValidNode(node))
            {
                InterlockedOr(NodeDebugFlags[nodeID], DBG_INVALID_NODE);
                continue;
            }

            InterlockedOr(NodeDebugFlags[nodeID], DBG_BG_USED_IN_PASS2);

            // BoxGrid visibility check
            if (!BoxGridNodeIsVisible(
                    node.BoundsMin,
                    node.BoundsMax,
                    ParticleToBoxGrid,
                    roomCenter,
                    roomDimensions,
                    zoomRegion,
                    viewerPosition,
                    FaceLayoutInfo,
                    crossLayoutInfo))
            {
                InterlockedOr(NodeDebugFlags[nodeID], DBG_FRUSTUM_OUTSIDE);
                continue;
            }
                InterlockedOr(NodeDebugFlags[nodeID], DBG_FRUSTUM_INSIDE);

            // LOD metric
            float screenSize = ComputeBoxGridScreenSize(
                node.BoundsMin,
                node.BoundsMax,
                viewerPosition,
                LODScale
            );

            // too small: discard
            if (screenSize < LODScreenSpaceThreshold * 0.5f)
                continue;

            bool isLeaf = (node.ChildStartIndex == 0xFFFFFFFF || node.ChildStartIndex == -1);

            if (isLeaf)
            {
                if (node.IndexCount > 0)
                {
                    uint writeIndex;
                    InterlockedAdd(VisibleNodeCounter[0], 1, writeIndex);
                    InterlockedAdd(TotalPointCounter[0], node.IndexCount);
                    VisibleNodeIDs[writeIndex] = nodeID;
                }
            }
            else
            {
                if (screenSize > LODScreenSpaceThreshold * 2.0f)
                {
                    // go deeper
                    for (int i = 0; i < 8; ++i)
                    {
                        if (stackTop < 511)
                            nodeStack[stackTop++] = node.ChildStartIndex + i;
                    }
                }
                else
                {
                    // render at this LOD: collect leaf descendants
                    int lodStack[256];
                    int lodTop = 0;
                    lodStack[lodTop++] = nodeID;

                    while (lodTop > 0 && lodTop < 256)
                    {
                        int lodNodeID = lodStack[--lodTop];
                        GPUOctreeNode lodNode = GpuOctreeNodes[lodNodeID];

                        bool lodIsLeaf = (lodNode.ChildStartIndex == 0xFFFFFFFF || lodNode.ChildStartIndex == -1);

                        if (lodIsLeaf)
                        {
                            if (lodNode.IndexCount > 0)
                            {
                                uint writeIndex;
                                InterlockedAdd(VisibleNodeCounter[0], 1, writeIndex);
                                InterlockedAdd(TotalPointCounter[0], lodNode.IndexCount);
                                VisibleNodeIDs[writeIndex] = lodNodeID;
                            }
                        }
                        else
                        {
                            for (int j = 0; j < 8; ++j)
                            {
                                if (lodTop < 255)
                                    lodStack[lodTop++] = lodNode.ChildStartIndex + j;
                            }
                        }
                    }
                }
            }
        }
    }

};