<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>VL.E57</AssemblyName>
        <RootNamespace>VL.E57</RootNamespace>
        <OutputPath>..\..\lib\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="VL.Core" Version="2025.7.0"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="VL.Core"/>
        <Using Include="VL.Core.Import"/>
        <Using Include="VL.Lib.Collections"/>
        <Using Include="Stride.Core.Mathematics"/>
    </ItemGroup>

</Project>
