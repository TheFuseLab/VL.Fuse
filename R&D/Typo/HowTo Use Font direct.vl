          <Pad Id="JCXMOg6dF93ME3kDIEyLtH" Bounds="951,1823,607,280" ShowValueBox="true" isIOBox="true" Value="// r, g, b  ==   three float values (the MSDF channels)&#xD;&#xA;float median(float r, float g, float b)&#xD;&#xA;{&#xD;&#xA;    // step-by-step:&#xD;&#xA;    // min(r,g)          – the smaller of r and g&#xD;&#xA;    // max(r,g)          – the larger of r and g&#xD;&#xA;    // max( min(r,g), b) – either b (if b is larger than both) or the smaller of r/g&#xD;&#xA;    // min( max(r,g), b) – either b (if b is smaller than both) or the larger of r/g&#xD;&#xA;    // Taking max(…, …) of those two results keeps the one that sits between the other two.&#xD;&#xA;    return max( min(r, g),          // the lower of r &amp; g&#xD;&#xA;                min( max(r, g), b)  // the lower of (higher of r &amp; g) and b&#xD;&#xA;              );&#xD;&#xA;}&#xD;&#xA;// r, g, b  ==   three float values (the MSDF channels)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
