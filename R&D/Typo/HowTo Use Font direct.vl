          <Pad Id="Jy80mAqXoRlPv61OHjdVqx" Comment="Path" Bounds="1969,141,193,24" ShowValueBox="true" isIOBox="true" Value="..\..\..\..\..\..\..\..\..\Assets\2023\ImaginaryFriends\RAS_2024_05_Google\assets\DataDisplays\Fonts\MSDF\FoundryGridnik-Regular\FoundryGridnik-Regular-atlas.png">
