          <Pad Id="UIYPnAA4HsDLvBmm46Ltzg" Bounds="2727,987,857,1107" ShowValueBox="true" isIOBox="true" Value="//------------------------------------------------------------------------------&#xD;&#xA;//  Constant buffer – all values are pushed from the CPU once per draw call.&#xD;&#xA;//  *pxRange* is exactly the “distanceRange” value reported by msdf-atlas-gen.&#xD;&#xA;//------------------------------------------------------------------------------&#xD;&#xA;cbuffer TextCB : register(b0)&#xD;&#xA;{&#xD;&#xA;    float4 fgColor;        // glyph colour (premultiplied or not – up to you)&#xD;&#xA;    float4 bgColor;        // background colour behind the quad&#xD;&#xA;    float   pxRange;       // same number you asked msdfgen for (e.g. 4, 8 …)&#xD;&#xA;    float2  atlasSize;     // original atlas size in texels (only needed for the&#xD;&#xA;                           // optional oversampling branch shown further down)&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Texture &amp; sampler ----------------------------------------------------------------&#xD;&#xA;Texture2D    FontMap      : register(t0);&#xD;&#xA;SamplerState LinearClamp  : register(s0);&#xD;&#xA;&#xD;&#xA;// Helpers --------------------------------------------------------------------------&#xD;&#xA;float median(float r, float g, float b)   // GLSL’s median, rewritten for HLSL&#xD;&#xA;{&#xD;&#xA;    return max(min(r, g), min(max(r, g), b));&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// When glyphs get very small MSDF can break down; the standalone SDF that many&#xD;&#xA;// atlas tools store in .a is a good fall-back.  We blend between the two based&#xD;&#xA;// on how many screen pixels the glyph currently covers.&#xD;&#xA;float signedDistance(float4 msdfSample)&#xD;&#xA;{&#xD;&#xA;    float  msdf = median(msdfSample.r, msdfSample.g, msdfSample.b);&#xD;&#xA;    float  sdf  = msdfSample.a;&#xD;&#xA;&#xD;&#xA;    // Heuristic: if fewer than ~3 screen pixels hit the quad, use plain SDF.&#xD;&#xA;    // You can tighten/loosen the ‘0.12’ threshold to taste.&#xD;&#xA;    float useSdf = step(0.12, fwidth(msdf));   // 1 = SDF, 0 = MSDF&#xD;&#xA;    return lerp(msdf, sdf, useSdf);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Pixel shader ---------------------------------------------------------------------&#xD;&#xA;float4 PS_Font(in float2 uv : TEXCOORD0) : SV_Target&#xD;&#xA;{&#xD;&#xA;    float4 sample   = FontMap.Sample(LinearClamp, uv);&#xD;&#xA;    float  sd       = signedDistance(sample);          // 0‥1 range&#xD;&#xA;    // Bring it back to signed distance in **pixels**:&#xD;&#xA;    //  - msdf encodes 0 → edge, 1 → +pxRange, 0 → –pxRange&#xD;&#xA;    float  distPx   = (sd * 2.0 - 1.0) * pxRange;&#xD;&#xA;&#xD;&#xA;    // One-pixel analytical anti-alias&#xD;&#xA;    float  smoothing = fwidth(distPx);                  // dx/dy derivatives&#xD;&#xA;    float  coverage  = smoothstep(0.0 - smoothing,      // standard 1-px filter&#xD;&#xA;                                  0.0 + smoothing,&#xD;&#xA;                                  distPx);&#xD;&#xA;&#xD;&#xA;    // Output premultiplied or straight alpha – here we keep it straight&#xD;&#xA;    return lerp(bgColor, fgColor, coverage);&#xD;&#xA;}&#xD;&#xA;">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="JCXMOg6dF93ME3kDIEyLtH" Bounds="951,1823,607,280" ShowValueBox="true" isIOBox="true" Value="// r, g, b  ==   three float values (the MSDF channels)&#xD;&#xA;float median(float r, float g, float b)&#xD;&#xA;{&#xD;&#xA;    // step-by-step:&#xD;&#xA;    // min(r,g)          – the smaller of r and g&#xD;&#xA;    // max(r,g)          – the larger of r and g&#xD;&#xA;    // max( min(r,g), b) – either b (if b is larger than both) or the smaller of r/g&#xD;&#xA;    // min( max(r,g), b) – either b (if b is smaller than both) or the larger of r/g&#xD;&#xA;    // Taking max(…, …) of those two results keeps the one that sits between the other two.&#xD;&#xA;    return max( min(r, g),          // the lower of r &amp; g&#xD;&#xA;                min( max(r, g), b)  // the lower of (higher of r &amp; g) and b&#xD;&#xA;              );&#xD;&#xA;}&#xD;&#xA;// r, g, b  ==   three float values (the MSDF channels)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="TwHd7th6ngHOBsyJofqisv" Bounds="2723,2369,596,296" ShowValueBox="true" isIOBox="true" Value="Why do we need the median in MSDF?&#xA;Each colour channel in an MSDF stores distance to one different edge of the glyph.&#xA;&#xA;At any given pixel two channels agree on the sign (inside vs. outside) and one channel is “wrong.”&#xA;&#xA;Taking the middle value (the median) discards that outlier, giving the true signed distance with much less aliasing than a single-channel SDF.  ">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
