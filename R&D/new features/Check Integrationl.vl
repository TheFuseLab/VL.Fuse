          <Pad Id="Vux2huikkqJN319uR82dwf" Bounds="1988,261,306,198" ShowValueBox="true" isIOBox="true" Value="Use when: Particles are far from target, subject to noise + attraction + drag. This is your far zone integrator.&#xD;&#xA;&#xD;&#xA;What it does: Solves the ODE dv/dt = -drag·v + F/m exactly (closed-form). No matter how large dt or drag, it never explodes.&#xD;&#xA;&#xD;&#xA;How it feels: Momentum with natural drag — like throwing a ball through honey. Particles coast, slow down, respond to changing forces smoothly.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
