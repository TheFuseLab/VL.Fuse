          <!--

    ************************ ComputeDecay ************************

-->
          <Node Name="ComputeDecay" Bounds="1486,480" Id="Jdkzgsuscy0OhKn8dQUqde">
            <p:NodeReference>
              <Choice Kind="ContainerDefinition" />
            </p:NodeReference>
            <Patch Id="VD3z8dOo2xVOlFYhcaPpUa">
              <Canvas Id="FlhXTNhDXJmMHMxOYiF6WI" CanvasType="Group">
                <Pad Id="OtlCmhfwZpmLivBMWzHd0f" Bounds="746,310,520,260" ShowValueBox="true" isIOBox="true" Value="float ComputeDecay(float dampingHalfLife, float dt)&#xA;{&#xA;    // Derived from: vel *= pow(0.5, dt / halfLife)&#xA;    // When halfLife = 0.1s, velocity halves every 0.1 seconds (heavy damping)&#xA;    // When halfLife = 1.0s, velocity halves every second (light damping)&#xA;    return exp(-0.693147 * dt / max(dampingHalfLife, 0.0001));&#xA;    // 0.693147 = ln(2)&#xA;}">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
                  <p:ValueBoxSettings>
                    <p:fontsize p:Type="Int32">9</p:fontsize>
                    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                  </p:ValueBoxSettings>
                </Pad>
