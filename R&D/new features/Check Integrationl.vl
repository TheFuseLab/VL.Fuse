          <Pad Id="Tw4S8MNbvEhOlnF7LzeFrH" Bounds="1489,230,306,198" ShowValueBox="true" isIOBox="true" Value="Use when: General-purpose fallback, first thing to swap in for the broken vel = accel.&#xD;&#xA;&#xD;&#xA;What it does: Updates velocity first, then uses the new velocity for position. This one swap preserves energy on average instead of pumping it up like forward Euler.&#xD;&#xA;&#xD;&#xA;How it feels: Bouncy, alive, slightly oscillating. Like a ball rolling in a bowl.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
