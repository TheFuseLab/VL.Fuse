          <!--

    ************************ InitializeCentroid ************************

-->
          <Node Name="InitializeCentroid" Bounds="180,691" Id="FWPgkXKa8BxNo1EcVE1ZPF">
            <p:NodeReference>
              <Choice Kind="ContainerDefinition" />
            </p:NodeReference>
            <Patch Id="M2Vrgm9dmIaL9lL6z8PRoJ">
              <Canvas Id="T2V6mV3Bfa3PtA6yUSDzMq" CanvasType="Group">
                <Node Bounds="363,1200,245,19" Id="Vo5adjScwimL8nsex578rE">
                  <p:NodeReference LastCategoryFullName="Fuse.Function" LastDependency="VL.Fuse.vl">
                    <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
                    <Choice Kind="ProcessAppFlag" Name="CustomFunction" />
                  </p:NodeReference>
                  <Pin Id="SENJ30wWbogLKw2fsmwhw6" Name="Node Context" Kind="InputPin" IsHidden="true" />
                  <Pin Id="NbBliKe8aEuLgP3gAk1nNg" Name="Function Name" Kind="InputPin" />
                  <Pin Id="IETyMJiTzY9PcW06YzmjGQ" Name="Code Template" Kind="InputPin" />
                  <Pin Id="ILGX4G7vcxILLWE4MbEai1" Name="Default Result" Kind="InputPin" IsHidden="true" />
                  <Pin Id="Gb1DTtGZqWMLVsOwGEsVjo" Name="Arguments" Kind="InputPin" />
                  <Pin Id="IXBx2Tm8HARMzd3DWMIJLQ" Name="Arguments 2" Kind="InputPin" />
                  <Pin Id="E5kTYYxTwz6P1dUwYkiq3s" Name="Arguments 3" Kind="InputPin" />
                  <Pin Id="DK3dOOVv4BNMrr1wVwzVhq" Name="Arguments 4" Kind="InputPin" />
                  <Pin Id="LdmC8cf8phSORCWaxUwBxd" Name="Arguments 5" Kind="InputPin" />
                  <Pin Id="LnrpkxbHWdLP0rlRlCZ6f9" Name="Arguments 6" Kind="InputPin" />
                  <Pin Id="Tiu0ckx0WMSOBK2d08u3oB" Name="Arguments 7" Kind="InputPin" />
                  <Pin Id="Mo7jycpA4u0P9h9fGHhGBm" Name="Delegates" Kind="InputPin" />
                  <Pin Id="I1zmkdWnQCAOYpHEWt9rBn" Name="Mixins" Kind="InputPin" />
                  <Pin Id="KWjjUvTW0u7PHTxr4N6Uuj" Name="Template Values" Kind="InputPin" />
                  <Pin Id="QbuYuCddgGoPAmIOd0PuLF" Name="Is Groupable" Kind="InputPin" IsHidden="true" />
                  <Pin Id="Nqhto1tofqrPgxCgMBjrG8" Name="The Modifiers" Kind="InputPin" />
                  <Pin Id="JMPHfR5WIlqP8GUdvwpds7" Name="Output" Kind="OutputPin" />
                </Node>
                <Pad Id="AeAsPZuJZfpLkHQ37PdfQz" Comment="Code Template" Bounds="714,1140,470,923" ShowValueBox="true" isIOBox="true" Value="// ==================== Initialize Centroids Function ====================&#xD;&#xA;void ${signature}(&#xD;&#xA;    StructuredBuffer&lt;float4&gt; positions,&#xD;&#xA;    RWStructuredBuffer&lt;float4&gt; centroids,&#xD;&#xA;    int clusterIndex,&#xD;&#xA;    int numPoints,&#xD;&#xA;    int numClusters,&#xD;&#xA;    int randomSeed,&#xD;&#xA;    bool useWeights)&#xD;&#xA;{&#xD;&#xA;    if (clusterIndex == 0)&#xD;&#xA;    {&#xD;&#xA;        // First centroid: weighted random selection&#xD;&#xA;        int bestPoint = 0;&#xD;&#xA;        float maxScore = 0;&#xD;&#xA;        &#xD;&#xA;        int sampleSize = min(numPoints, 1024);&#xD;&#xA;        for (int i = 0; i &lt; sampleSize; i++)&#xD;&#xA;        {&#xD;&#xA;            float weight = useWeights ? positions[i].w : 1.0;&#xD;&#xA;            int hash = PCGHash(i + randomSeed * 1000 + clusterIndex);&#xD;&#xA;            float randomValue = abs(float(hash)) / 2147483647.0; // Normalize to [0,1]&#xD;&#xA;            float score = weight * randomValue;&#xD;&#xA;            &#xD;&#xA;            if (score &gt; maxScore)&#xD;&#xA;            {&#xD;&#xA;                maxScore = score;&#xD;&#xA;                bestPoint = i;&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;        &#xD;&#xA;        centroids[0] = positions[bestPoint];&#xD;&#xA;    }&#xD;&#xA;    else&#xD;&#xA;    {&#xD;&#xA;        // K-means++ initialization: choose points far from existing centroids&#xD;&#xA;        float maxMinDist = 0;&#xD;&#xA;        int bestPoint = 0;&#xD;&#xA;        int stride = max(1, numPoints / 1024);&#xD;&#xA;        &#xD;&#xA;        for (int i = 0; i &lt; numPoints; i += stride)&#xD;&#xA;        {&#xD;&#xA;            float minDist = 999999.0;&#xD;&#xA;            &#xD;&#xA;            // Find distance to nearest existing centroid&#xD;&#xA;            for (int c = 0; c &lt; clusterIndex; c++)&#xD;&#xA;            {&#xD;&#xA;                float dist = ${DIST_FUNC}(positions[i], centroids[c]);&#xD;&#xA;                minDist = min(minDist, dist);&#xD;&#xA;            }&#xD;&#xA;            &#xD;&#xA;            float weight = useWeights ? positions[i].w : 1.0;&#xD;&#xA;            float score = minDist * minDist * weight;&#xD;&#xA;            &#xD;&#xA;            if (score &gt; maxMinDist)&#xD;&#xA;            {&#xD;&#xA;                maxMinDist = score;&#xD;&#xA;                bestPoint = i;&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;        &#xD;&#xA;        centroids[clusterIndex] = positions[bestPoint];&#xD;&#xA;    }&#xD;&#xA;}">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
                </Pad>
