                <Pad Id="Ai8c0azSWKkOWr1LqAoBeS" Comment="Code Template" Bounds="714,1140,470,923" ShowValueBox="true" isIOBox="true" Value="// ==================== Assign Points to Clusters ====================&#xD;&#xA;void ${signature}(&#xD;&#xA;    StructuredBuffer&lt;float4&gt; positions,&#xD;&#xA;    StructuredBuffer&lt;float4&gt; centroids,&#xD;&#xA;    RWStructuredBuffer&lt;int&gt; clusterIDs,&#xD;&#xA;    RWStructuredBuffer&lt;float&gt; distances,&#xD;&#xA;    int pointIndex,&#xD;&#xA;    int numClusters)&#xD;&#xA;{&#xD;&#xA;    float4 point = positions[pointIndex];&#xD;&#xA;    float minDist = 999999.0;&#xD;&#xA;    int nearestCluster = 0;&#xD;&#xA;    &#xD;&#xA;    for (int k = 0; k &lt; numClusters; k++)&#xD;&#xA;    {&#xD;&#xA;        float dist = ${DIST_FUNC}(point, centroids[k]);&#xD;&#xA;        if (dist &lt; minDist)&#xD;&#xA;        {&#xD;&#xA;            minDist = dist;&#xD;&#xA;            nearestCluster = k;&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    clusterIDs[pointIndex] = nearestCluster;&#xD;&#xA;    distances[pointIndex] = minDist;&#xD;&#xA;}">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
                </Pad>
