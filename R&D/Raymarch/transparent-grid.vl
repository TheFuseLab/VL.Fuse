                <Pad Id="AiNx8eHyS7cMi1jGhVJkhg" Bounds="915,477,575,395" ShowValueBox="true" isIOBox="true" Value="float3 refractRay(float3 incomingDir, float3 normal, float n1, float n2, out bool isTotalInternalReflection)&#xD;&#xA;{&#xD;&#xA;    float eta = n1 / n2;&#xD;&#xA;    float cosThetaI = dot(incomingDir, normal);&#xD;&#xA;    float sin2ThetaT = eta * eta * (1.0 - cosThetaI * cosThetaI);&#xD;&#xA;&#xD;&#xA;    isTotalInternalReflection = sin2ThetaT &gt; 1.0;&#xD;&#xA;    &#xD;&#xA;    if (isTotalInternalReflection)&#xD;&#xA;    {&#xD;&#xA;        return float3(0, 0, 0); // or handle total internal reflection as needed&#xD;&#xA;    }&#xD;&#xA;    else&#xD;&#xA;    {&#xD;&#xA;        return eta * (incomingDir - normal * cosThetaI) - normal * sqrt(1.0 - sin2ThetaT);&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
                  <p:ValueBoxSettings>
                    <p:fontsize p:Type="Int32">9</p:fontsize>
                    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                  </p:ValueBoxSettings>
                </Pad>
