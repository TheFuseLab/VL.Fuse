                <!--

    ************************ InsertNeighbor ************************

-->
                <Node Name="InsertNeighbor" Bounds="707,183" Id="IcY7qF56SLzMPr7mu7u2Lm">
                  <p:NodeReference>
                    <Choice Kind="ContainerDefinition" />
                  </p:NodeReference>
                  <Patch Id="ROLFEdaAEwQNXhSIlmHjc1">
                    <Canvas Id="TZzLtQbLDRMNw7VvWYMTZD" CanvasType="Group">
                      <Pad Id="H6lVBK2GsxNMFk6MazPFir" Bounds="2924,473,631,642" ShowValueBox="true" isIOBox="true" Value="void InsertNeighbor(uint particleId, uint newId, float newDistSq) {&#xD;&#xA;    uint baseIndex = particleId * MAX_NEIGHBORS;&#xD;&#xA;    uint count = Particles[particleId].neighborCount;&#xD;&#xA;    &#xD;&#xA;    // Early out if already at max and new distance is larger than largest stored&#xD;&#xA;    if (count &gt;= MAX_NEIGHBORS &amp;&amp; newDistSq &gt;= Distances[baseIndex + MAX_NEIGHBORS - 1]) {&#xD;&#xA;        return;&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    // Find insertion point and check existence&#xD;&#xA;    uint insertIndex = count;&#xD;&#xA;    [unroll]&#xD;&#xA;    for (uint i = 0; i &lt; min(count, MAX_NEIGHBORS); i++) {&#xD;&#xA;        if (NeighborIds[baseIndex + i] == newId) return;&#xD;&#xA;        if (newDistSq &lt; Distances[baseIndex + i]) {&#xD;&#xA;            insertIndex = i;&#xD;&#xA;            break;&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    // Simple shift - compiler will optimize this well&#xD;&#xA;    uint shiftCount = min(count, MAX_NEIGHBORS - 1) - insertIndex;&#xD;&#xA;    [unroll]&#xD;&#xA;    for (uint i = 0; i &lt; shiftCount; i++) {&#xD;&#xA;        uint idx = (min(count, MAX_NEIGHBORS - 1) - i);&#xD;&#xA;        NeighborIds[baseIndex + idx] = NeighborIds[baseIndex + idx - 1];&#xD;&#xA;        Distances[baseIndex + idx] = Distances[baseIndex + idx - 1];&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    // Insert new neighbor&#xD;&#xA;    NeighborIds[baseIndex + insertIndex] = newId;&#xD;&#xA;    Distances[baseIndex + insertIndex] = newDistSq;&#xD;&#xA;    Particles[particleId].neighborCount = min(count + 1, MAX_NEIGHBORS);&#xD;&#xA;}">
                        <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                          <Choice Kind="TypeFlag" Name="String" />
                        </p:TypeAnnotation>
                        <p:ValueBoxSettings>
                          <p:fontsize p:Type="Int32">9</p:fontsize>
                          <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                        </p:ValueBoxSettings>
                      </Pad>
