                <Pad Id="UvxdlvqLPgeOT20hwcLdqe" Bounds="700,374,625,838" ShowValueBox="true" isIOBox="true" Value="[numthreads(256, 1, 1)]&#xD;&#xA;void UpdateNeighbors(uint3 DTid : SV_DispatchThreadID) {&#xD;&#xA;    uint particleId = DTid.x;&#xD;&#xA;    if (particleId &gt;= particleCount) return;&#xD;&#xA;    &#xD;&#xA;    float3 pos = Particles[particleId].position;&#xD;&#xA;    uint baseIndex = particleId * MAX_NEIGHBORS;&#xD;&#xA;    &#xD;&#xA;    // Store previous neighbors&#xD;&#xA;    uint prevCount = Particles[particleId].neighborCount;&#xD;&#xA;    uint prevNeighbors[MAX_NEIGHBORS];&#xD;&#xA;    [unroll]&#xD;&#xA;    for (uint i = 0; i &lt; prevCount; i++) {&#xD;&#xA;        prevNeighbors[i] = NeighborIds[baseIndex + i];&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    // Reset neighbor count&#xD;&#xA;    Particles[particleId].neighborCount = 0;&#xD;&#xA;    &#xD;&#xA;    // Recheck previous neighbors first&#xD;&#xA;    for (uint i = 0; i &lt; prevCount; i++) {&#xD;&#xA;        uint neighborId = prevNeighbors[i];&#xD;&#xA;        float3 deltaPos = Particles[neighborId].position - pos;&#xD;&#xA;        float distSq = dot(deltaPos, deltaPos);&#xD;&#xA;        &#xD;&#xA;        if (distSq &lt;= maxDistance * maxDistance) {&#xD;&#xA;            InsertNeighbor(particleId, neighborId, sqrt(distSq));&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    // Add random samples to potentially find new closer neighbors&#xD;&#xA;    uint rngState = pcg_random(particleId + frameCount * 719393);&#xD;&#xA;    for (uint i = 0; i &lt; RANDOM_SAMPLES; i++) {&#xD;&#xA;        uint candidateId = uint(rand(rngState) * particleCount);&#xD;&#xA;        if (candidateId != particleId &amp;&amp; candidateId &lt; particleCount) {&#xD;&#xA;            float3 deltaPos = Particles[candidateId].position - pos;&#xD;&#xA;            float distSq = dot(deltaPos, deltaPos);&#xD;&#xA;            &#xD;&#xA;            if (distSq &lt;= maxDistance * maxDistance) {&#xD;&#xA;                InsertNeighbor(particleId, candidateId, sqrt(distSq));&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;}">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
                  <p:ValueBoxSettings>
                    <p:fontsize p:Type="Int32">9</p:fontsize>
                    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                  </p:ValueBoxSettings>
                </Pad>
