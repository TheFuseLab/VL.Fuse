shader BoneIds
{
    // Small accumulator for up to 12 inputs, deduplicated by bone id
    struct Accum { uint id; float w; };

    static const float kEps = 1e-6f;

    // Insert or accumulate weight for a bone id in a small array.
    // Returns new count if an empty slot was used, otherwise count unchanged.
    uint AccumAdd(inout Accum acc[12], uint count, uint id, float w)
    {
        if (w <= 0.0f) return count;

        [unroll]
        for (uint i = 0; i < count; ++i)
        {
            if (acc[i].id == id)
            {
                acc[i].w += w;
                return count;
            }
        }
        acc[count].id = id;
        acc[count].w  = w;
        return count + 1;
    }

    // Select top-4 by weight (descending). Always fully writes out params.
    void SelectTop4(Accum acc[12], uint count, out uint4 outIds, out float4 outW)
    {
        // initialize with -inf
        float bestW[4] = { -1e30, -1e30, -1e30, -1e30 };
        uint  bestI[4] = { 0, 0, 0, 0 };

        [unroll]
        for (uint i = 0; i < count; ++i)
        {
            float w = acc[i].w;
            uint  id = acc[i].id;

            if (w > bestW[0]) { bestW[3]=bestW[2]; bestI[3]=bestI[2];
                                bestW[2]=bestW[1]; bestI[2]=bestI[1];
                                bestW[1]=bestW[0]; bestI[1]=bestI[0];
                                bestW[0]=w;        bestI[0]=i; }
            else if (w > bestW[1]) { bestW[3]=bestW[2]; bestI[3]=bestI[2];
                                     bestW[2]=bestW[1]; bestI[2]=bestI[1];
                                     bestW[1]=w;        bestI[1]=i; }
            else if (w > bestW[2]) { bestW[3]=bestW[2]; bestI[3]=bestI[2];
                                     bestW[2]=w;        bestI[2]=i; }
            else if (w > bestW[3]) { bestW[3]=w;        bestI[3]=i; }
        }

        // Write OUTs on all paths (avoid reading acc when count is too small)
        outIds = uint4(
            (count > 0) ? acc[bestI[0]].id : 0,
            (count > 1) ? acc[bestI[1]].id : 0,
            (count > 2) ? acc[bestI[2]].id : 0,
            (count > 3) ? acc[bestI[3]].id : 0
        );

        outW = float4(
            (count > 0) ? max(acc[bestI[0]].w, 0.0) : 0.0,
            (count > 1) ? max(acc[bestI[1]].w, 0.0) : 0.0,
            (count > 2) ? max(acc[bestI[2]].w, 0.0) : 0.0,
            (count > 3) ? max(acc[bestI[3]].w, 0.0) : 0.0
        );

        float s = outW.x + outW.y + outW.z + outW.w;
        if (s > kEps) outW /= s;
    }

    // Barycentric blend of per-vertex influences -> top-4 influences for the new point
    int4 InterpolateSkinInfluences(
        int4 a, int4 b, int4 c,
        float4 aw, float4 bw, float4 cw,
        float3 bc,
        out float4 w)
    {
        // ---- initialize everything the analyzer might worry about ----
        Accum acc[12];
        [unroll] for (uint i = 0; i < 12; ++i) { acc[i].id = 0; acc[i].w = 0.0; }  // <—
        uint count = 0;

        // Guard against degenerate inputs (still fully write OUT)
        float sBC = bc.x + bc.y + bc.z;
        if (sBC <= 0.0f) { w = float4(0,0,0,0); return int4(0,0,0,0); }

        // Accumulate weighted influences
        [unroll] for (uint i0 = 0; i0 < 4; ++i0) count = AccumAdd(acc, count, (uint)a[i0], bc.x * aw[i0]);
        [unroll] for (uint i1 = 0; i1 < 4; ++i1) count = AccumAdd(acc, count, (uint)b[i1], bc.y * bw[i1]);
        [unroll] for (uint i2 = 0; i2 < 4; ++i2) count = AccumAdd(acc, count, (uint)c[i2], bc.z * cw[i2]);

        // Select top-4 (ensure locals are initialized before passing as OUT)
        uint4 idsU = uint4(0,0,0,0);      // <—
        float4 wF  = float4(0,0,0,0);     // <—
        SelectTop4(acc, count, idsU, wF);

        w = wF;
        return int4(idsU);
    }
};
