          <Pad Id="Uc80kdTQNtbQaYlrI5ioqG" Bounds="1354,16,269,30" ShowValueBox="true" isIOBox="true" Value="OneLoopEmissionIntegration ">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">13</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Sk1JLBuvkVWLOKszofeA6M" Bounds="1354,51,378,174" ShowValueBox="true" isIOBox="true" Value="This node performs emission, force evaluation, and integration in a single compute loop. A spatial noise field is evaluated once per particle per frame and reused consistently for:&#xD;&#xA;emission probability&#xD;&#xA;initial force / velocity&#xD;&#xA;continuous motion integration&#xD;&#xA;&#xD;&#xA;This avoids redundant noise evaluations and keeps emission and motion spatially coherent.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="I8suA3Jb436OdtDk8bd3TM" Bounds="1354,241,269,30" ShowValueBox="true" isIOBox="true" Value="One-Loop Model">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">13</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="IenpQH2ppQMLsO6bTUarg4" Bounds="1354,276,378,174" ShowValueBox="true" isIOBox="true" Value="Instead of separating emission and simulation into multiple passes, this node:&#xD;&#xA;evaluates noise&#xD;&#xA;decides emission&#xD;&#xA;computes velocity&#xD;&#xA;integrates position&#xD;&#xA;all within one loop.&#xD;&#xA;This reduces memory traffic, minimizes branching, and makes the system easier to reason about on the GPU.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Ssvpukl65mvOTdPEIQPnKT" Bounds="1354,472,269,30" ShowValueBox="true" isIOBox="true" Value="Dead Particle Pre-Initialization">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">13</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="HU3mrTw9yhCQRknnI8aSjV" Bounds="1354,507,385,222" ShowValueBox="true" isIOBox="true" Value="Position and velocity are always computed, even for inactive particles. This is intentional. Dead particles already have:&#xD;&#xA;a valid position in space&#xD;&#xA;a valid velocity / force context&#xD;&#xA;&#xD;&#xA;When a particle becomes active:&#xD;&#xA;it does not snap to a new position&#xD;&#xA;emission can depend on spatial fields immediately&#xD;&#xA;spawning is deterministic and temporally stable&#xD;&#xA;&#xD;&#xA;This allows position-based emission masks and avoids late or discontinuous initialization.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="UnfIVueUSNVPXRi7ng1Qkw" Bounds="1354,762,269,30" ShowValueBox="true" isIOBox="true" Value="Why this makes sense">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">13</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="J0924mKsRCML7U1lAlq48u" Bounds="1354,797,384,130" ShowValueBox="true" isIOBox="true" Value="Noise is expensive → evaluate once, reuse everywhere&#xD;&#xA;Emission and motion share the same spatial structures&#xD;&#xA;No mismatch between where particles spawn and how they move&#xD;&#xA;Stable, deterministic behavior across frames&#xD;&#xA;Scales well for large GPU particle counts">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
        </Canvas>
