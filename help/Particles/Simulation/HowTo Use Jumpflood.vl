          <Pad Id="AfA1Xe6ZVKwPoBazRjsHE0" Bounds="3301,1261,577,534" ShowValueBox="true" isIOBox="true" Value="void IntegrateExponentialDrag(&#xA;    inout float3 pos,&#xA;    inout float3 vel,&#xA;    float3 force,   // total external force (attraction + noise + swirl)&#xA;    float mass,     // particle mass&#xA;    float drag,     // drag coefficient (1.0 = moderate, 5.0 = heavy, 0.2 = floaty)&#xA;    float dt&#xA;)&#xA;{&#xA;    // Terminal velocity: the speed this force would produce at equilibrium&#xA;    // When drag·vel = force/mass, acceleration = 0, so vTerminal = force / (mass·drag)&#xA;    float3 vTerminal = force / (mass * drag);&#xA;&#xA;    // How much of the &quot;gap&quot; between current vel and terminal vel decays this frame&#xA;    float decay = exp(-drag * dt);&#xA;&#xA;    // Exact position update (integrated analytically)&#xA;    //   pos += vTerminal * dt   ← distance from steady-state motion&#xA;    //        + (vel - vTerminal) * (1 - decay) / drag   ← distance from transient&#xA;    pos += vTerminal * dt + (vel - vTerminal) * (1.0 - decay) / drag;&#xA;&#xA;    // Exact velocity update&#xA;    //   vel blends from current toward terminal velocity&#xA;    vel = vTerminal + (vel - vTerminal) * decay;&#xA;}">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
