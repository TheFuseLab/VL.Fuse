          <Pad Id="HY6bhu4u1BtOqJb87Um9DJ" Bounds="55,76,510,201" ShowValueBox="true" isIOBox="true" Value="The Voronoi-based particle tracking implementation maintains a sorted list of nearest neighbors for each particle, using squared distances for efficiency. &#xD;&#xA;&#xD;&#xA;The algorithm first checks previous frame neighbors, then examines neighbors-of-neighbors (focusing more on closer neighbors), and finally adds random samples if needed to ensure good spatial coverage. &#xD;&#xA;&#xD;&#xA;Each particle maintains up to MAX_NEIGHBORS closest particles within a maximum distance, with neighbors sorted by distance during insertion. The neighbor data is stored in separate buffers for neighbor IDs and squared distances, allowing for efficient updates and memory access patterns.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
